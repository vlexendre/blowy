{
  "name": "@blowy/pet-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v4": {
      "types": "./dist/v4/index.d.ts",
      "default": "./dist/v4/index.js"
    },
    "./v5": {
      "types": "./dist/v5/index.d.ts",
      "default": "./dist/v5/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/simulate/tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "simulate": "tsx src/simulate/cli.ts"
  },
  "dependencies": {
    "@blowy/domain": "workspace:*",
    "@blowy/tuning": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
