// =============================================================================
// BLOWY — schéma PostgreSQL (propriétaire unique : agent C, cf. AGENTS.md)
// Conventions :
//  - UUID v7 générés côté application (D-008) ; colonnes `@db.Uuid`.
//  - UTC partout (`timestamptz`) ; timezone IANA dans des colonnes texte dédiées.
//  - XP en milli-points entiers, pièces en entiers ; axes de vision en millièmes [-1000,1000].
//  - onDelete explicite sur chaque relation. Les utilisateurs ne sont jamais supprimés
//    physiquement par l'application (suppression = anonymisation + statut DELETED),
//    d'où `Restrict` par défaut vers User ; les contenus privés purgeables sont en
//    tables séparées (MessageContent, IncubationAnswer, BranchBallot, SafetyLocationPoint).
//  - Contraintes non exprimables en Prisma (CHECK, index partiels) :
//    prisma/migrations/*_constraints/migration.sql
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

