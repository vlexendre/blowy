/// Quartier (spec-v5 §2.1). La ville = `Zone` (fuseau, amorçage par ville fermée, V5.1 B.7).
model Neighborhood {
  id                String             @id @default(uuid(7)) @db.Uuid
  slug              String             @unique
  name              String
  /// Nom de ville affiché (« Paris », « Lyon », « Saint-Denis »).
  city              String
  cityZoneId        String             @db.Uuid
  timezone          String
  status            NeighborhoodStatus @default(WAITLIST)
  densityThreshold  Int                @default(120)
  /// Date estimée honnête (V5.1 B.6), saisie par ops ; jamais inventée.
  estimatedLaunchAt DateTime?          @db.Timestamptz(3)
  launchedAt        DateTime?          @db.Timestamptz(3)
  pausedAt          DateTime?          @db.Timestamptz(3)
  /// V5.6 (E11) : centre du quartier (saisi par ops) — sert seulement à ESTIMER un temps de trajet en l'absence de ligne
  /// `NeighborhoodTravelTime` ; jamais la position d'une personne. Absent → moyenne des lieux actifs du quartier.
  centerLat         Float?
  centerLng         Float?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  version           Int                @default(0)

  cityZone      Zone                         @relation(fields: [cityZoneId], references: [id], onDelete: Restrict)
  slotTemplates NeighborhoodSlotTemplate[]
  venues        Venue[]
  residents     User[]                       @relation("UserNeighborhood")
  waitlist      WaitlistEntry[]
  requests      OutingRequest[]
  outings       Outing[]
  acceptedBy    UserAcceptableNeighborhood[]

  @@index([cityZoneId, status])
}

/// Créneau type hebdomadaire d'un quartier (heure murale du quartier) et son activité (V5.1 D.13–D.14).
model NeighborhoodSlotTemplate {
  id             String       @id @default(uuid(7)) @db.Uuid
  neighborhoodId String       @db.Uuid
  isoWeekday     Int
  /// Minutes depuis minuit, heure locale du quartier (ex. 19 h 30 = 1170).
  localMinute    Int
  activity       ActivityKind
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  neighborhood Neighborhood           @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  availability UserSlotAvailability[]

  @@unique([neighborhoodId, isoWeekday, localMinute])
}

/// Lieu partenaire (spec-v5 §2.3). Adresse et coordonnées révélées aux seuls confirmés au verrouillage.
model Venue {
  id                      String           @id @default(uuid(7)) @db.Uuid
  neighborhoodId          String           @db.Uuid
  name                    String
  addressLine             String
  postalCode              String
  city                    String
  /// Coordonnées servant au check-in uniquement ; jamais une distance affichée.
  lat                     Float
  lng                     Float
  offerKey                String
  photoUrl                String?
  activities              ActivityKind[]
  /// Tables-sorties simultanées par créneau.
  tablesPerSlot           Int              @default(1)
  status                  VenueStatus      @default(ACTIVE)
  accessibilityTags       String[]
  /// Référence du secret HMAC du code de repli (le secret est dérivé côté serveur ; jamais en clair ici).
  checkinSecretRef        String
  /// Visible staff ops uniquement.
  staffContact            String?
  /// V5.5 (D-055) : ambiance du lieu (CALM | LIVELY) ; null = convient à tous.
  ambiance                Ambiance?
  /// V5.6 (E15) : contrat bilatéral — signature du lieu (projection de l'espace lieu) et contre-signature Blowy.
  contractVersion         String?
  contractSignedAt        DateTime?        @db.Timestamptz(3)
  contractSignerName      String?
  blowySignedAt           DateTime?        @db.Timestamptz(3)
  blowySignerName         String?
  /// V5.7 (E30, D-080) : message d'accueil écrit par le lieu (≤ 280 car., texte seul, modéré) ; montré aux seules places confirmées à partir de la confirmation.
  /// V5.9 : activité précise du lieu (`@blowy/content` `ACTIVITY_DETAILS`, ex. `ceramics_workshop`) ; null = libellé générique de l'activité.
  activityDetailKey       String?
  /// V5.10 (jury tour 11) : prix TTC de l'activité par personne (centimes), prépayé dans l'app avec la place ; null = prix du catalogue.
  activityPriceCents      Int?
  /// V5.10 : régime du reversement de l'activité au lieu (TTC par défaut ; HT = Blowy reverse le montant hors taxe).
  activityTaxBasis        ActivityTaxBasis @default(TTC)
  welcomeMessage          String?
  welcomeMessageUpdatedAt DateTime?        @db.Timestamptz(3)
  /// V5.10 (passe 5) : note de table écrite par le lieu (≤ 80 car., texte seul, modérée) ; places confirmées, dès la confirmation.
  tableNote               String?
  tableNoteUpdatedAt      DateTime?        @db.Timestamptz(3)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)
  slots        VenueSlot[]
  outings      Outing[]
  duoDates     DuoDate[]

  @@index([neighborhoodId, status])
}

model VenueSlot {
  id              String       @id @default(uuid(7)) @db.Uuid
  venueId         String       @db.Uuid
  startsAt        DateTime     @db.Timestamptz(3)
  activity        ActivityKind
  capacityOutings Int
  reservedOutings Int          @default(0)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  outings Outing[]

  @@unique([venueId, startsAt])
  @@index([startsAt])
}

/// Liste d'attente (spec-v5 §2.2) : une seule entrée par personne, AUCUNE position individuelle.
model WaitlistEntry {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @unique @db.Uuid
  neighborhoodId   String    @db.Uuid
  joinedAt         DateTime  @db.Timestamptz(3)
  notifiedLaunchAt DateTime? @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
}

/// Préférences de sortie V5.1 (D.13–D.14, C.10, B.8). Déclaratives ; jamais de géolocalisation.
model OutingPreferences {
  userId                   String         @id @db.Uuid
  groupAgeMin              Int
  groupAgeMax              Int
  /// Vide = toutes les activités.
  activities               ActivityKind[]
  maxTravelMinutes         Int            @default(30)
  /// V5.5 (D-055) : ambiance souhaitée (ANY = peu importe).
  ambiance                 Ambiance       @default(ANY)
  /// V5.4 (B.9) : garde alternée — « une semaine sur deux » à partir de cette semaine ISO (`YYYY-Www`, off) ; null = non.
  alternateWeeksOffFrom    String?
  /// V5.6 (B.13) : « un week-end sur deux » à partir de cette semaine ISO (week-end de cette semaine off) ; null = non.
  alternateWeekendsOffFrom String?
  /// V5.7 (E32, D-084) : « Montrer au groupe : je préfère le calme » (badge sur le pet, à partir de FORMING) ; désactivé par défaut.
  showCalmBadge            Boolean        @default(false)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAcceptableNeighborhood {
  userId         String @db.Uuid
  neighborhoodId String @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@id([userId, neighborhoodId])
  @@index([neighborhoodId])
}

model UserSlotAvailability {
  userId         String @db.Uuid
  slotTemplateId String @db.Uuid

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotTemplate NeighborhoodSlotTemplate @relation(fields: [slotTemplateId], references: [id], onDelete: Cascade)

  @@id([userId, slotTemplateId])
}

/// Semaines off (garde alternée…), clé `YYYY-Www` (CHECK format).
model UserWeekOff {
  userId  String @db.Uuid
  weekKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekKey])
}

/// Team « Viens avec ta team » (V5.1 B.7) : 1 à 3 personnes d'une même ville, unité indivisible.
model Team {
  id          String     @id @default(uuid(7)) @db.Uuid
  cityZoneId  String     @db.Uuid
  createdById String     @db.Uuid
  status      TeamStatus @default(FORMING)
  /// Code d'invitation aléatoire (lien partagé) ; jamais un identifiant interne.
  inviteCode  String     @unique
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  dissolvedAt DateTime?  @db.Timestamptz(3)
  version     Int        @default(0)

  cityZone Zone         @relation(fields: [cityZoneId], references: [id], onDelete: Restrict)
  members  TeamMember[]

  @@index([cityZoneId, status])
}

/// Membre de team : au plus une team active par personne (index unique partiel `leftAt IS NULL`).
model TeamMember {
  id       String    @id @default(uuid(7)) @db.Uuid
  teamId   String    @db.Uuid
  userId   String    @db.Uuid
  joinedAt DateTime  @db.Timestamptz(3)
  leftAt   DateTime? @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
}

/// Demande hebdo (spec-v5 §2.4) : une par personne et par semaine.
model OutingRequest {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @db.Uuid
  neighborhoodId String              @db.Uuid
  weekKey        String
  slotStartsAt   DateTime[]          @db.Timestamptz(3)
  teamId         String?             @db.Uuid
  /// V5.5 (D-061) : « sortir quand même, en amitié » cette semaine.
  mode           OutingRequestMode   @default(NORMAL)
  status         OutingRequestStatus @default(OPEN)
  /// Code de diagnostic staff (jamais montré tel quel à l'utilisateur).
  unplacedReason UnplacedReason?
  missedWeeks    Int                 @default(0)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)

  @@unique([userId, weekKey])
  @@index([neighborhoodId, weekKey, status])
}

/// Lot de composition (diagnostic) : stats agrégées, aucun identifiant de préférence.
model CompositionRun {
  id            String               @id @default(uuid(7)) @db.Uuid
  /// `zone:<zoneId>` (hebdo, par ville) ; `zone:<zoneId>@<fenêtre>` (amorçage).
  scopeKey      String
  weekKey       String
  /// V5.5 (D-053) : jour local du créneau composé (runs `ROLLING`) ; null pour les runs historiques.
  slotDate      DateTime?            @db.Date
  kind          CompositionRunKind
  status        CompositionRunStatus @default(RUNNING)
  algoVersion   String
  tuningVersion String
  seed          String
  stats         Json?
  startedAt     DateTime             @db.Timestamptz(3)
  finishedAt    DateTime?            @db.Timestamptz(3)

  outings Outing[]

  @@unique([scopeKey, weekKey, kind])
}

/// Sortie (spec-v5 §2.5). Instants figés à la création (versions tuning tracées).
model Outing {
  id               String              @id @default(uuid(7)) @db.Uuid
  neighborhoodId   String              @db.Uuid
  weekKey          String
  kind             CompositionRunKind  @default(WEEKLY)
  venueSlotId      String              @db.Uuid
  venueId          String              @db.Uuid
  activity         ActivityKind
  startsAt         DateTime            @db.Timestamptz(3)
  endsAt           DateTime            @db.Timestamptz(3)
  status           OutingStatus        @default(PROPOSED)
  capacity         Int
  composedAt       DateTime            @db.Timestamptz(3)
  acceptDeadline   DateTime            @db.Timestamptz(3)
  lockAt           DateTime            @db.Timestamptz(3)
  photoRevealAt    DateTime            @db.Timestamptz(3)
  checkinOpensAt   DateTime            @db.Timestamptz(3)
  checkinClosesAt  DateTime            @db.Timestamptz(3)
  votesCloseAt     DateTime            @db.Timestamptz(3)
  /// Dépouillement fait (résultats publiés à date fixe, V5.1 A.4).
  votesClosedAt    DateTime?           @db.Timestamptz(3)
  /// Bulletins purgés (rétention §8.5).
  ballotsPurgedAt  DateTime?           @db.Timestamptz(3)
  cancelReason     OutingCancelReason?
  cancelledAt      DateTime?           @db.Timestamptz(3)
  compositionRunId String?             @db.Uuid
  tuningVersion    String
  algoVersion      String
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  version          Int                 @default(0)

  neighborhood   Neighborhood    @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)
  venueSlot      VenueSlot       @relation(fields: [venueSlotId], references: [id], onDelete: Restrict)
  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  compositionRun CompositionRun? @relation(fields: [compositionRunId], references: [id], onDelete: SetNull)
  seats          OutingSeat[]
  votes          OutingVote[]
  conversation   Conversation?

  @@index([status, lockAt])
  @@index([neighborhoodId, weekKey])
}

/// Place (spec-v5 §2.6). Une place active par personne et par semaine (index unique partiel).
model OutingSeat {
  id             String          @id @default(uuid(7)) @db.Uuid
  outingId       String          @db.Uuid
  userId         String          @db.Uuid
  weekKey        String
  teamId         String?         @db.Uuid
  status         SeatStatus      @default(INVITED)
  funding        SeatFunding?
  /// Référence du paiement (T3 : Payment.id ; LOCAL_DEMO : `local_demo:<seatId>`).
  paymentRef     String?
  /// Référence du crédit consommé (T3).
  creditRef      String?
  holdExpiresAt  DateTime?       @db.Timestamptz(3)
  acceptDeadline DateTime        @db.Timestamptz(3)
  invitedAt      DateTime        @db.Timestamptz(3)
  confirmedAt    DateTime?       @db.Timestamptz(3)
  respondedAt    DateTime?       @db.Timestamptz(3)
  cancelledAt    DateTime?       @db.Timestamptz(3)
  checkedInAt    DateTime?       @db.Timestamptz(3)
  cancelKind     SeatCancelKind?
  refundState    RefundState     @default(NONE)
  refundRef      String?
  version        Int             @default(0)

  outing          Outing                 @relation(fields: [outingId], references: [id], onDelete: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkIn         OutingCheckIn?
  knowsSomeone    KnowsSomeoneRequest?
  checkInAttempts OutingCheckInAttempt[]
  dispute         AttendanceDispute?

  @@unique([outingId, userId])
  @@index([outingId, status])
  @@index([status, holdExpiresAt])
  @@index([userId, status])
}

/// Check-in accepté (§2.8) — AUCUNE position stockée (pas de colonne lat/lng).
model OutingCheckIn {
  seatId    String        @id @db.Uuid
  method    CheckInMethod
  createdAt DateTime      @db.Timestamptz(3)

  seat OutingSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
}

/// Essais de check-in (comptage des essais de code) : résultat et précision par tranche seulement.
model OutingCheckInAttempt {
  id             String          @id @default(uuid(7)) @db.Uuid
  seatId         String          @db.Uuid
  method         CheckInMethod
  result         CheckInResult
  accuracyBucket AccuracyBucket?
  createdAt      DateTime        @db.Timestamptz(3)

  seat OutingSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([seatId, method])
}

/// Bulletin de vote d'après (§2.10, V5.1 A). Table séparée, jamais jointe dans une projection
/// d'autrui ; purgée `votes.ballotRetentionDays` après la clôture.
model OutingVote {
  id           String     @id @default(uuid(7)) @db.Uuid
  outingId     String     @db.Uuid
  voterUserId  String     @db.Uuid
  targetUserId String     @db.Uuid
  choice       VoteChoice
  createdAt    DateTime   @db.Timestamptz(3)
  updatedAt    DateTime   @db.Timestamptz(3)

  outing Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)

  @@unique([outingId, voterUserId, targetUserId])
  @@index([outingId])
}

/// Accord mutuel révélé (résultat durable du dépouillement ; jamais un « non »).
model ConnectionReveal {
  id           String         @id @default(uuid(7)) @db.Uuid
  sourceKind   String
  sourceId     String         @db.Uuid
  userLowId    String         @db.Uuid
  userHighId   String         @db.Uuid
  result       ConnectionKind
  revealedAt   DateTime       @db.Timestamptz(3)
  friendshipId String?        @db.Uuid
  duoId        String?        @db.Uuid

  @@unique([sourceKind, sourceId, userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
}

/// Duo (spec-v5 §2.12) — créé ici par un accord « plus » (OUTING_VOTE) ; voie Duo : T5 (C2).
model Duo {
  id             String    @id @default(uuid(7)) @db.Uuid
  userLowId      String    @db.Uuid
  userHighId     String    @db.Uuid
  origin         DuoOrigin
  /// V5.10 (passe 5) : type du duo, posé à la création seulement s'il est su des deux (vote « plus » mutuel, ou voie Duo entre deux personnes qui ne cherchent qu'une histoire / que des potes) ; null sinon.
  kind           DuoKind?
  status         DuoStatus
  exchangeEndsAt DateTime? @db.Timestamptz(3)
  dateDeadline   DateTime? @db.Timestamptz(3)
  messagesLow    Int       @default(0)
  messagesHigh   Int       @default(0)
  datesAttended  Int       @default(0)
  sourceOutingId String?   @db.Uuid
  /// V5 T5 (C2) : proposition voie Duo d'origine (LANE).
  proposalId     String?   @unique @db.Uuid
  /// A déjà été TOGETHER (retour après un RDV refusé, annulé ou non tenu).
  together       Boolean   @default(false)
  /// Œuf (T9) : désactivé par défaut ; actif seulement si les DEUX côtés l'ont activé.
  eggOptInLow    Boolean   @default(false)
  eggOptInHigh   Boolean   @default(false)
  /// Fin (EXPIRED/CLOSED/LEFT) : la conversation reste lisible 7 j après une expiration.
  endedAt        DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  version        Int       @default(0)

  userLow      User          @relation("DuoLow", fields: [userLowId], references: [id], onDelete: Restrict)
  userHigh     User          @relation("DuoHigh", fields: [userHighId], references: [id], onDelete: Restrict)
  conversation Conversation?
  dates        DuoDate[]

  @@index([userLowId])
  @@index([userHighId])
  @@index([status, exchangeEndsAt])
  @@index([status, dateDeadline])
}

/// Rendez-vous à deux (spec-v5 §2.12) — lieu public partenaire ; un seul PROPOSED/CONFIRMED par duo (index partiel).
model DuoDate {
  id                  String        @id @default(uuid(7)) @db.Uuid
  duoId               String        @db.Uuid
  proposedByUserId    String        @db.Uuid
  venueId             String        @db.Uuid
  startsAt            DateTime      @db.Timestamptz(3)
  endsAt              DateTime      @db.Timestamptz(3)
  status              DuoDateStatus
  checkinLowAt        DateTime?     @db.Timestamptz(3)
  checkinHighAt       DateTime?     @db.Timestamptz(3)
  votesCloseAt        DateTime?     @db.Timestamptz(3)
  votesClosedAt       DateTime?     @db.Timestamptz(3)
  ballotsPurgedAt     DateTime?     @db.Timestamptz(3)
  cancelledByUserId   String?       @db.Uuid
  /// Annulation à moins de 24 h (comptée en fiabilité) — jamais montrée à l'autre.
  lateCancel          Boolean       @default(false)
  /// V5.6 (E13) : table de 2 au lieu partenaire — créneau du lieu (si le lieu publie ses créneaux) et heure à laquelle la réservation est entrée dans l'effectif (veille 18 h).
  venueSlotId         String?       @db.Uuid
  reservationLockedAt DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @db.Timestamptz(3)
  updatedAt           DateTime      @db.Timestamptz(3)
  version             Int           @default(0)

  duo      Duo                     @relation(fields: [duoId], references: [id], onDelete: Cascade)
  venue    Venue                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  votes    DuoVote[]
  attempts DuoDateCheckInAttempt[]

  @@index([duoId])
  @@index([status, startsAt])
}

/// Bulletin d'après-rendez-vous (même résolution que §2.10) ; purgé 7 j après la clôture.
model DuoVote {
  id          String     @id @default(uuid(7)) @db.Uuid
  duoDateId   String     @db.Uuid
  voterUserId String     @db.Uuid
  choice      VoteChoice
  createdAt   DateTime   @db.Timestamptz(3)
  updatedAt   DateTime   @db.Timestamptz(3)

  duoDate DuoDate @relation(fields: [duoDateId], references: [id], onDelete: Cascade)

  @@unique([duoDateId, voterUserId])
}

/// Essais de check-in d'un RDV duo (aucune position stockée : résultat et tranche de précision seulement).
model DuoDateCheckInAttempt {
  id             String          @id @default(uuid(7)) @db.Uuid
  duoDateId      String          @db.Uuid
  userId         String          @db.Uuid
  method         CheckInMethod
  result         CheckInResult
  accuracyBucket AccuracyBucket?
  createdAt      DateTime        @db.Timestamptz(3)

  duoDate DuoDate @relation(fields: [duoDateId], references: [id], onDelete: Cascade)

  @@index([duoDateId, userId, method])
}

/// « Passer » une proposition voie Duo : silencieux pour l'autre (la proposition expire normalement de son côté).
model DuoLanePass {
  id         String   @id @default(uuid(7)) @db.Uuid
  proposalId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @db.Timestamptz(3)

  @@unique([proposalId, userId])
  @@index([userId])
}

/// « Ta rue » (V5.2 G.21, V5.3 F.24) : ordre de MES souvenirs dans le décor (action facultative, sans notification).
model StreetArrangement {
  userId    String   @id @db.Uuid
  memoryIds String[] @db.Uuid
  updatedAt DateTime @db.Timestamptz(3)
}

/// « Ta rue » : accessoire gagné offert (à montrer) au pet d'un membre de MA bande — visible seulement
/// dans la rue du destinataire ; le donneur le garde ; aucune notification, aucun compteur.
model StreetGift {
  id          String   @id @default(uuid(7)) @db.Uuid
  fromUserId  String   @db.Uuid
  toUserId    String   @db.Uuid
  linkId      String   @db.Uuid
  accessoryId String
  createdAt   DateTime @db.Timestamptz(3)

  @@unique([fromUserId, toUserId, accessoryId])
  @@index([toUserId, createdAt])
}

/// Fiabilité « venu·e à N sorties sur M » (§2.14, V5.1 E.16) — projection idempotente.
model ReliabilityStat {
  userId          String    @id @db.Uuid
  attended        Int       @default(0)
  noShows         Int       @default(0)
  /// Annulations après verrouillage (V5.1 : comptées comme absence).
  lateCancels     Int       @default(0)
  /// Absences de l'épisode courant (remis à zéro après une pause).
  episodeAbsences Int       @default(0)
  lastAbsenceAt   DateTime? @db.Timestamptz(3)
  pausedUntil     DateTime? @db.Timestamptz(3)
  pauseEpisode    Int       @default(0)
  updatedAt       DateTime  @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Contestation d'absence (§2.14) ; résolution staff (T6).
model AttendanceDispute {
  id           String                  @id @default(uuid(7)) @db.Uuid
  seatId       String                  @unique @db.Uuid
  userId       String                  @db.Uuid
  /// Note privée (purge 1 an après résolution).
  note         String
  status       AttendanceDisputeStatus @default(OPEN)
  resolvedById String?                 @db.Uuid
  createdAt    DateTime                @db.Timestamptz(3)
  resolvedAt   DateTime?               @db.Timestamptz(3)

  seat OutingSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// Souvenir du pet (§2.13) : jamais perdu ; `dedupKey` = `<kind>:<refId>:<petId>`.
model PetMemory {
  id        String        @id @default(uuid(7)) @db.Uuid
  petId     String        @db.Uuid
  kind      PetMemoryKind
  refType   String
  refId     String        @db.Uuid
  dedupKey  String        @unique
  data      Json
  createdAt DateTime      @db.Timestamptz(3)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt(sort: Desc), id(sort: Desc)])
}

/// Accessoire gagné (jamais acheté) ; `accessoryId` = clé `@blowy/content`.
model PetAccessory {
  id          String          @id @default(uuid(7)) @db.Uuid
  petId       String          @db.Uuid
  accessoryId String
  source      AccessorySource
  unlockedAt  DateTime        @db.Timestamptz(3)
  equipped    Boolean         @default(false)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, accessoryId])
}

enum KnowsSomeoneStatus {
  AUTO_ACCEPTED
  IN_REVIEW
  ACCEPTED
  REJECTED
  /// Mort en V5.6 (E23) : plus jamais écrit (au-delà du quota = SAFETY_REVIEW).
  COUNTED_AS_CANCEL
  /// V5.6 (E23) : au-delà d'1 déplacement par mois — sortie pour raison de sécurité (remboursée, sans pénalité) examinée par un humain.
  SAFETY_REVIEW
}

/// V5.2 (C.10) « Je connais quelqu'un ici » : signalement PRIVÉ (jamais montré à la personne visée),
/// une demande par place ; 1 par mois et par personne (au-delà : annulation).
model KnowsSomeoneRequest {
  id           String             @id @default(uuid(7)) @db.Uuid
  seatId       String             @unique @db.Uuid
  userId       String             @db.Uuid
  targetUserId String             @db.Uuid
  status       KnowsSomeoneStatus
  createdAt    DateTime           @db.Timestamptz(3)
  resolvedAt   DateTime?          @db.Timestamptz(3)

  seat OutingSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// V5 — Sécurité (module `safety`, agent E, spec-v5 §2.9, V5.1 G, V5.2 C/H)
// Aucune clé étrangère vers User : le module purge ses lignes lui-même (rétention §8.5).
// -----------------------------------------------------------------------------

enum GuardianSubjectKind {
  OUTING
  DUO_DATE
}

enum SafetyAlertStatus {
  OPEN
  SAFE
  HANDLED
}

/// Lien « ange gardien » : jeton aléatoire 32 octets, seule son empreinte SHA-256 est stockée.
/// Ni numéro ni email du proche ; ni IP ni empreinte de navigateur des lectures.
model GuardianLink {
  id           String              @id @default(uuid(7)) @db.Uuid
  ownerUserId  String              @db.Uuid
  subjectKind  GuardianSubjectKind
  subjectId    String              @db.Uuid
  tokenHash    String              @unique
  label        String?
  activeFrom   DateTime            @db.Timestamptz(3)
  expiresAt    DateTime            @db.Timestamptz(3)
  revokedAt    DateTime?           @db.Timestamptz(3)
  revokeReason String?
  lastViewedAt DateTime?           @db.Timestamptz(3)
  viewCount    Int                 @default(0)
  createdAt    DateTime            @db.Timestamptz(3)

  push GuardianPushSubscription?

  @@index([subjectKind, subjectId])
  @@index([ownerUserId, subjectId])
  @@index([expiresAt])
}

/// Abonnement Web Push du proche (souscrit depuis la page) : seul l'endpoint est gardé — les
/// notifications sont SANS contenu (aucune clé de chiffrement nécessaire, donc aucune stockée).
model GuardianPushSubscription {
  id             String   @id @default(uuid(7)) @db.Uuid
  guardianLinkId String   @unique @db.Uuid
  endpoint       String
  createdAt      DateTime @db.Timestamptz(3)
  purgeAfter     DateTime @db.Timestamptz(3)

  link GuardianLink @relation(fields: [guardianLinkId], references: [id], onDelete: Cascade)
}

/// Alerte « besoin d'aide » : dossier SAFETY prioritaire ; position jointe seulement par choix
/// explicite, purgée à `positionPurgeAfter` (sauf dossier ouvert → à sa clôture).
model SafetyAlert {
  id                 String              @id @default(uuid(7)) @db.Uuid
  userId             String              @db.Uuid
  subjectKind        GuardianSubjectKind
  subjectId          String              @db.Uuid
  status             SafetyAlertStatus   @default(OPEN)
  lat                Float?
  lng                Float?
  accuracyM          Int?
  positionPurgeAfter DateTime?           @db.Timestamptz(3)
  positionPurgedAt   DateTime?           @db.Timestamptz(3)
  moderationCaseId   String?             @db.Uuid
  createdAt          DateTime            @db.Timestamptz(3)
  ackAt              DateTime?           @db.Timestamptz(3)
  resolvedAt         DateTime?           @db.Timestamptz(3)
  handledById        String?             @db.Uuid

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([subjectKind, subjectId])
}

/// « Tout va bien » (chronologie du proche).
model SafetyOkSignal {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String              @db.Uuid
  subjectKind GuardianSubjectKind
  subjectId   String              @db.Uuid
  createdAt   DateTime            @db.Timestamptz(3)

  @@index([subjectKind, subjectId, userId])
}

/// Retrait système (D-025) déclenché par un blocage ou un « je connais quelqu'un » accepté :
/// trace staff (signal d'abus ≥ [T] safety.removalAbuseThreshold en 30 j), jamais exposée aux membres.
model SafetySystemRemoval {
  id                String   @id @default(uuid(7)) @db.Uuid
  outingId          String   @db.Uuid
  seatId            String   @unique @db.Uuid
  removedUserId     String   @db.Uuid
  triggeredByUserId String   @db.Uuid
  cause             String
  createdAt         DateTime @db.Timestamptz(3)

  @@index([triggeredByUserId, createdAt])
}

/// Signalement « incident sur place » (lieu, personnel, autre client) SANS personne visée parmi
/// les participants (V5.2 H.23). Note privée, purgée avec les dossiers (2 ans après clôture).
model SafetyIncident {
  id               String   @id @default(uuid(7)) @db.Uuid
  reporterId       String   @db.Uuid
  outingId         String   @db.Uuid
  venueId          String?  @db.Uuid
  note             String?
  moderationCaseId String?  @db.Uuid
  createdAt        DateTime @db.Timestamptz(3)

  @@index([outingId])
}

/// « Je pars, mal à l'aise » (V5.3 B.9) : départ sans pénalité ; message staff (dossier), au gardien
/// seulement si la personne l'a choisi ; 3 départs → recontact humain. Une ligne par place.
model SafetyUneasyLeave {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  outingId       String   @db.Uuid
  seatId         String   @unique @db.Uuid
  notifyGuardian Boolean  @default(false)
  createdAt      DateTime @db.Timestamptz(3)

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// V5.4 (A.6, D-049) — « éviter les personnes que je connais » (opt-in). Protocole : spec-v5 §4.5.
// Aucune colonne de numéro, d'empreinte de contact ni de liste de contacts.

/// Numéro VÉRIFIÉ de la personne, sous forme de condensé d'un jeton OPRF (jamais le numéro ni le jeton brut).
model PhoneIdentity {
  userId      String   @id @db.Uuid
  /// HMAC-SHA256(clé serveur, jeton OPRF du numéro E.164) en base64url.
  tokenDigest String   @unique
  verifiedAt  DateTime @db.Timestamptz(3)
}

/// Paire à ne jamais composer ensemble (symétrique, CHECK low < high, jamais révélée aux intéressé·es).
model AvoidPair {
  userLowId  String   @db.Uuid
  userHighId String   @db.Uuid
  createdAt  DateTime @db.Timestamptz(3)

  @@id([userLowId, userHighId])
  @@index([userHighId])
}

// -----------------------------------------------------------------------------
// V5.5 — astreinte, indicateurs de ville, parrainage.

/// Astreinte (D-058) : créneau de couverture humaine, mutualisé par FUSEAU (pas par ville). Aucun créneau de
/// sortie ni rendez-vous Duo n'est proposé hors couverture.
model SafetyOnCallShift {
  id        String   @id @default(uuid(7)) @db.Uuid
  timezone  String
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  teamLabel String
  /// Référence du numéro d'astreinte (jamais le numéro en base).
  phoneRef  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([timezone, startsAt])
}

/// Indicateurs de ville (D-059) : photographie QUOTIDIENNE (comptes bruts, accès serveur seulement, purge 30 j).
model CityInsightSnapshot {
  cityZoneId String   @db.Uuid
  day        DateTime @db.Date
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([cityZoneId, day])
}

/// Parrainage (D-064) : 1ʳᵉ sortie vécue d'un·e filleul·e → prochaine sortie offerte au parrain, ≤ 1 par mois.
model ReferralReward {
  id             String    @id @default(uuid(7)) @db.Uuid
  referrerUserId String    @db.Uuid
  refereeUserId  String    @unique @db.Uuid
  /// Mois calendaire du parrain 'YYYY-MM'.
  period         String
  createdAt      DateTime  @db.Timestamptz(3)
  /// Place financée par cette récompense (null = encore disponible).
  consumedSeatId String?   @unique @db.Uuid
  consumedAt     DateTime? @db.Timestamptz(3)

  @@unique([referrerUserId, period])
  @@index([referrerUserId, consumedSeatId])
}

// ---------------------------------------------------------------- V5.6 (concept-v5.6, agent C)

/// V5.6 (E11, §2.1) : temps de trajet typique (transports en commun) entre quartiers, maintenu par ops.
model NeighborhoodTravelTime {
  id                 String   @id @default(uuid(7)) @db.Uuid
  fromNeighborhoodId String   @db.Uuid
  toNeighborhoodId   String   @db.Uuid
  minutes            Int
  updatedAt          DateTime @db.Timestamptz(3)

  @@unique([fromNeighborhoodId, toNeighborhoodId])
}

/// V5.6 (E16, §2.17) : un lien par carte et par personne, jamais réutilisé ; conservé 13 mois.
model ShareLink {
  id                     String        @id @default(uuid(7)) @db.Uuid
  slug                   String        @unique
  ownerUserId            String        @db.Uuid
  cardKind               ShareCardKind
  /// Référence opaque du sujet (sortie, team, ville) — jamais exposée telle quelle.
  subjectRef             String?
  clickCount             Int           @default(0)
  attributedSignups      Int           @default(0)
  attributedFirstOutings Int           @default(0)
  createdAt              DateTime      @db.Timestamptz(3)
  expiresAt              DateTime      @db.Timestamptz(3)

  @@index([ownerUserId, createdAt])
}

/// V5.6 (E16) : arrivée attribuée à un lien (une seule par personne).
model ShareAttribution {
  id            String    @id @default(uuid(7)) @db.Uuid
  shareLinkId   String    @db.Uuid
  userId        String    @unique @db.Uuid
  createdAt     DateTime  @db.Timestamptz(3)
  firstOutingAt DateTime? @db.Timestamptz(3)

  @@index([shareLinkId])
}

/// V5.6 (E19) : journal append-only de l'espace lieu (remplace `DomainEvent` aggregateType `venue.partner`).
model VenuePartnerEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  venueId     String   @db.Uuid
  seq         Int
  type        String
  actorUserId String?  @db.Uuid
  payload     Json
  occurredAt  DateTime @db.Timestamptz(3)

  @@unique([venueId, seq])
}

/// V5.6 (E19) : accès partenaire d'un compte à un lieu (projection du journal).
model VenuePartnerAccess {
  venueId   String    @db.Uuid
  userId    String    @db.Uuid
  grantedAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@id([venueId, userId])
  @@index([userId])
}

/// V5.6 (E19) : MFA du compte partenaire (génération d'enrôlement, enrôlé ou non).
model VenuePartnerMfa {
  userId     String    @id @db.Uuid
  generation Int       @default(0)
  enrolledAt DateTime? @db.Timestamptz(3)
  updatedAt  DateTime  @db.Timestamptz(3)
}

/// V5.6 (E19) : jours d'ouverture et plafond de tables du lieu.
model VenueWeekday {
  venueId    String   @db.Uuid
  isoWeekday Int
  open       Boolean
  tables     Int?
  note       String?
  updatedAt  DateTime @db.Timestamptz(3)

  @@id([venueId, isoWeekday])
}

/// V5.6 (E19) : fermetures exceptionnelles du lieu.
model VenueClosure {
  id        String   @id @default(uuid(7)) @db.Uuid
  venueId   String   @db.Uuid
  date      String
  note      String
  createdAt DateTime @db.Timestamptz(3)

  @@index([venueId, date])
}

/// V5.6 (E19) : signalements d'un participant par le lieu (prénom seulement côté lieu).
model VenueIncident {
  id        String   @id @db.Uuid
  venueId   String   @db.Uuid
  outingId  String   @db.Uuid
  firstName String
  motive    String
  note      String
  seatId    String?  @db.Uuid
  userId    String?  @db.Uuid
  createdAt DateTime @db.Timestamptz(3)

  @@index([venueId, createdAt])
  @@index([createdAt])
}

/// V5.10 : régime de reversement de l'activité prépayée au lieu.
enum ActivityTaxBasis {
  TTC
  HT
}

/// V5.10 (passe 5) : pastille du duo (« Pour une histoire » / « Pour un·e pote »).
enum DuoKind {
  FRIENDS
  STORY
}
