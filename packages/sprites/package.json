{
  "name": "@blowy/sprites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/data/asset-sources.d.ts",
      "default": "./dist/data/asset-sources.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "scan": "python3 -I scripts/scan_assets.py"
  },
  "dependencies": {
    "@blowy/domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
