# ── API (apps/api/.env) ─────────────────────────────────────────────
BLOWY_ENV=local                 # local | production
BLOWY_ADAPTERS=memory           # memory (sans rien d'externe) | supabase
PORT=3000
SUPABASE_URL=https://sqxebllmatfflopqddaw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # Supabase → Project Settings → API keys → secret key (ne jamais la mettre dans l'app)
RESEND_API_KEY=                 # vide = e-mails écrits dans la console
MAIL_FROM=Blowy <hello@blowy.app>
WEB_URL=https://blowy.app
CORS_ORIGINS=https://blowy.app,http://localhost:4321,http://localhost:8081
# Plateforme : IA, push, minuteur (voir apps/api/README.md et docs/COUTS.md)
ANTHROPIC_API_KEY=              # vide = IA mémoire en local, IA coupée avec supabase (les règles prennent le relais)
AI_PROVIDER=                    # anthropic | memory | off (défaut : selon la clé et les adaptateurs)
AI_MODEL_SMALL=claude-haiku-5-5
AI_MODEL_MEDIUM=claude-sonnet-5-5
AI_KILL_SWITCH=0                # 1 = plus aucun appel d'IA
AI_DAILY_CEILING_USD=3          # plafond global de dépense par jour
AI_USER_BUDGETS=                # ex. chat_remark=4,habit_proof=6,weekly_review=1,moderation=4
AI_PRICES_SMALL=                # entrée,sortie,écriture cache,lecture cache ($/million) ; vide = prix publics
AI_PRICES_MEDIUM=
AI_EUR_PER_USD=0.9              # affichage en euros dans l'administration (approximatif)
PUSH_PROVIDER=                  # expo | memory | off (défaut : memory en mémoire, expo avec supabase)
EXPO_ACCESS_TOKEN=              # seulement si « enhanced push security » est activé chez Expo
INTERNAL_TICK_SECRET=           # 24 caractères au moins ; vide = POST /internal/tick désactivé
TICK_BUDGET_MS=20000
# Activités en direct iOS (docs/WIDGETS.md) : les trois ensemble, ou aucun (= pas d'envoi)
APNS_KEY_P8=                    # contenu de la clé .p8 (PEM ; « \n » littéraux acceptés)
APNS_KEY_ID=                    # 10 caractères (portail Apple › Keys)
APNS_TEAM_ID=                   # 10 caractères (Team ID)
APNS_ENVIRONMENT=production     # production (TestFlight, App Store) | sandbox (builds de développement)
# Blowy+ et administration (docs/BLOWY-PLUS.md)
ADMIN_EMAILS=                   # adresses autorisées dans l'administration (https://admin.minimoa.app), séparées par des virgules
APPLE_BUNDLE_ID=app.blowy
APPLE_APP_APPLE_ID=             # requis en production
APPLE_ACCEPT_SANDBOX=1
PLUS_PRODUCT_YEARLY=app.blowy.plus.yearly
PLUS_PRODUCT_MONTHLY=app.blowy.plus.monthly
PLUS_PRODUCT_WEEKLY=app.blowy.plus.weekly
REVENUECAT_APPLE_NOTIFICATIONS_URL= # facultatif, https : « Apple Server Notification URL » de RevenueCat (docs/BLOWY-PLUS.md §6)
# Audit App Store (docs/APP-REVIEW.md) : compte de revue d'Apple et alertes de modération
REVIEW_EMAIL=                   # adresse du compte de revue (vide : connexion par e-mail fermée)
REVIEW_CODE=                    # code fixe, 10 caractères au moins en production ; va avec REVIEW_EMAIL
ADMIN_URL=                      # adresse de l'administration (liens des alertes) : https://admin.minimoa.app ; défaut WEB_URL/admin

# ── App (apps/mobile/.env) ──────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=https://blowy.app
EXPO_PUBLIC_SUPABASE_URL=https://sqxebllmatfflopqddaw.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_tO2WBMeLyfZTxzMkC8-9xA_M_fG0DQM
EXPO_PUBLIC_AUTH=supabase       # supabase | local (dev : pas d'e-mail, va avec BLOWY_ADAPTERS=memory)

# ── Site (apps/web/.env) ────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:3000
