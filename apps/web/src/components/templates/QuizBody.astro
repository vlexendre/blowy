---
/**
 * « Quel minimoa es-tu ? » dans une langue (docs/VIRALITE.md) : intro, situations, résultat, résultat partagé, erreur.
 * Rendu par pages/quiz (français), pages/[lang]/quiz (traductions) et pages/lien/quiz (copie servie pour /quiz/<code>).
 * Tout le reste se passe côté navigateur (scripts/quiz-page.ts), dans la langue de la page.
 */
import StoreButtons from '../molecules/StoreButtons.astro';
import CodeBox from '../organisms/public/CodeBox.astro';
import QuartierForm from '../organisms/public/QuartierForm.astro';
import { quizCopy } from '../../content/quiz';
import { growthCopy } from '../../content/growth';
import { localePath, type Locale } from '../../i18n/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = quizCopy[locale].quiz;
const pets = ['nino', 'suzie', 'gaston', 'pia'];
---
<section class="pub-state quiz-intro" data-state="intro">
    <span class="lbl">{t.intro.kicker}</span>
    <h1 class="pub-title" tabindex="-1" data-quiz-intro-title>{t.intro.title.map((l, i) => <span class:list={['ln', { acc: i === 1 }]}>{l}</span>)}</h1>
    <p class="pub-text">{t.intro.text}</p>
    <div class="quiz-faces" aria-hidden="true">{pets.map((p) => <img src={`/img/${p}_face.webp`} alt="" width="72" height="72" />)}</div>
    <button type="button" class="btn l quiz-go" data-quiz-start>{t.intro.start}</button>
    <p class="quiz-facts">{t.intro.facts}</p>
  </section>

  <section class="pub-state quiz-q" data-state="question" hidden>
    <div class="quiz-top">
      <button type="button" class="quiz-back" data-quiz-back>{t.back}</button>
      <span class="quiz-step" data-quiz-step></span>
    </div>
    <div class="quiz-progress" aria-hidden="true"><i data-quiz-bar></i></div>
    <h2 class="quiz-prompt" tabindex="-1" data-quiz-prompt></h2>
    <div class="quiz-choices" data-quiz-choices role="group"></div>
  </section>

  <section class="pub-state pub-loading" data-state="computing" hidden aria-live="polite" aria-busy="true">
    <div class="spin" aria-hidden="true"></div>
    <p>{t.computing}</p>
  </section>

  <section class="pub-state quiz-result" data-state="result" hidden>
    <span class="lbl">{t.result.kicker}</span>
    <h2 class="pub-title" tabindex="-1" data-quiz-headline></h2>
    <span class="quiz-pill" data-quiz-species></span>
    <p class="quiz-sentence" data-quiz-sentence></p>
    <p class="quiz-second" data-quiz-second></p>
    <figure class="quiz-card">
      <img data-quiz-card alt="" width="1080" height="1920" />
    </figure>
    <div class="pub-actions quiz-actions">
      <button type="button" class="btn l" data-quiz-story>{t.result.story}</button>
      <button type="button" class="btn w" data-quiz-challenge>{t.result.challenge}</button>
      <button type="button" class="btn g" data-quiz-copy>{t.result.copy}</button>
    </div>
    <p class="quiz-note" data-quiz-note role="status" hidden></p>

    <div class="pub-dl quiz-keep">
      <b>{t.result.keepTitle}</b>
      <CodeBox label={t.result.codeLabel} help={t.result.keepText} copy={growthCopy[locale].copy} box="quiz" />
      <div class="pub-actions"><a class="btn g" data-quiz-open href="minimoa://quiz">{t.result.open}</a></div>
      <StoreButtons locale={locale} />
    </div>

    <div class="pub-dl"><QuartierForm locale={locale} /></div>
    <a class="quiz-again" href={localePath(locale, '/quiz/')}>{t.result.again}</a>
  </section>

  <section class="pub-state quiz-shared" data-state="shared" hidden>
    <img class="pub-pet" data-quiz-shared-pet src="/img/m/quiz_sociable.webp" alt="" width="720" height="800" />
    <span class="quiz-pill" data-quiz-shared-species></span>
    <span class="lbl">{t.shared.kicker}</span>
    <h2 class="pub-title" tabindex="-1">{t.shared.title.map((l, i) => <span class:list={['ln', { acc: i === 1 }]}>{l}</span>)}</h2>
    <p class="pub-text">{t.shared.text}</p>
    <button type="button" class="btn l quiz-go" data-quiz-start>{t.shared.cta}</button>
  </section>

  <section class="pub-state" data-state="error" hidden>
    <img class="pub-pet" src="/img/nino_surpris.webp" alt="" width="900" height="1000" />
    <p class="pub-text" data-quiz-error>{t.error}</p>
    <div class="pub-actions"><a class="btn l" href={localePath(locale, '/quiz/')}>{t.result.again}</a></div>
  </section>
<style is:global>
.quiz-intro .pub-title,.quiz-shared .pub-title{font-size:clamp(46px,14vw,84px)}
.quiz-faces{display:flex;gap:6px}
.quiz-faces img{width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,.08);border:3px solid rgba(255,255,255,.12);object-fit:cover}
.quiz-go{min-width:200px}
.quiz-facts{font-size:13px;font-weight:700;color:var(--mute)}
.quiz-top{display:flex;justify-content:space-between;align-items:center;width:100%}
.quiz-back{min-height:44px;padding:0 4px;font-weight:800;color:var(--mute)}
.quiz-back[hidden]{visibility:hidden;display:block}
.quiz-step{font-weight:800;font-size:15px;color:var(--mute)}
.quiz-progress{width:100%;height:8px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden}
.quiz-progress i{display:block;height:100%;width:0;background:var(--lime);border-radius:999px;transition:width .35s ease}
.quiz-prompt{font-family:var(--display);font-weight:800;font-size:clamp(26px,7vw,38px);line-height:1.08;letter-spacing:-.015em;text-wrap:balance;margin:6px 0 4px;outline:none}
.quiz-choices{display:flex;flex-direction:column;gap:10px;width:100%}
.quiz-choice{display:flex;align-items:center;gap:12px;width:100%;min-height:64px;padding:14px 18px;border-radius:22px;background:rgba(255,255,255,.07);border:1px solid var(--line);text-align:left;font-size:17px;font-weight:700;line-height:1.3;transition:transform .15s,background .15s}
.quiz-choice:hover{background:rgba(255,255,255,.12)}
.quiz-choice:active{transform:scale(.98)}
.quiz-choice b{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--lime);color:var(--ink);font-weight:800}
.quiz-choice[aria-pressed="true"]{background:rgba(255,184,0,.18);border-color:var(--lime)}
.quiz-result .pub-title{font-size:clamp(38px,11vw,64px)}
.quiz-pill{display:inline-flex;align-items:center;border-radius:999px;padding:8px 16px;background:var(--lime);color:var(--ink);font-weight:800;font-size:17px}
.quiz-pill:empty{display:none}
.quiz-sentence{font-size:19px;font-weight:600;line-height:1.4;text-wrap:pretty}
.quiz-second{font-size:15px;font-weight:700;color:var(--mute)}
.quiz-second:empty{display:none}
.quiz-card{margin:4px 0;align-self:center;width:min(300px,72vw);aspect-ratio:9/16;border-radius:24px;overflow:hidden;background:rgba(255,255,255,.06);box-shadow:0 24px 50px rgba(0,0,0,.4)}
.quiz-card img{width:100%;height:100%;object-fit:cover}
.quiz-actions .btn{flex:1 1 auto}
.quiz-note{font-weight:700;color:var(--lime)}
.quiz-note[hidden]{display:none}
.quiz-again{font-weight:800;color:var(--mute);text-decoration:underline;align-self:center;min-height:44px;display:inline-flex;align-items:center}
@media (prefers-reduced-motion:reduce){.quiz-progress i,.quiz-choice{transition:none}}
</style>
