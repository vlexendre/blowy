---
/**
 * « Ouvre ton quartier » dans une langue (docs/VIRALITE.md) : formulaire, quartier ouvert, confirmation, désinscription.
 * Rendu par pages/quartier (français), pages/[lang]/quartier et pages/lien/quartier (copie servie pour
 * /quartier/<zone>, /quartier/confirmer, /quartier/desinscription). Logique : scripts/quartier-page.ts.
 */
import StoreButtons from '../molecules/StoreButtons.astro';
import CodeBox from '../organisms/public/CodeBox.astro';
import QuartierForm from '../organisms/public/QuartierForm.astro';
import { quizCopy } from '../../content/quiz';
import { growthCopy } from '../../content/growth';
import { localePath, type Locale } from '../../i18n/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = quizCopy[locale].quartier;
---
<section class="pub-state pub-loading" data-state="loading" aria-live="polite" aria-busy="true" hidden>
    <div class="spin" aria-hidden="true"></div>
  </section>

  <section class="pub-state" data-state="form">
    <img class="pub-pet qp-pet" src="/img/m/groupe.webp" alt="" width="700" height="460" />
    <QuartierForm level={1} locale={locale} />
  </section>

  <section class="pub-state" data-state="open" hidden>
    <img class="pub-pet qp-pet" src="/img/m/bande_fete.webp" alt="" width="1200" height="520" />
    <h1 class="pub-title" tabindex="-1">{t.openTitle}</h1>
    <p class="qp-zone" data-qp-zone></p>
    <p class="pub-text">{t.openText}</p>
    <StoreButtons locale={locale} />
    <CodeBox label={growthCopy[locale].ref.label} help={t.codeHelp} copy={growthCopy[locale].copy} box="quartier" hidden />
    <div class="pub-actions"><a class="btn g" data-qp-open href="minimoa://quartier">{t.openApp}</a></div>
  </section>

  <section class="pub-state" data-state="confirmed" hidden>
    <img class="pub-pet" src="/img/m/nino_applaudit.webp" alt="" width="450" height="500" />
    <h1 class="pub-title" tabindex="-1">{t.confirmTitle}</h1>
    <p class="pub-text">{t.confirmText}</p>
    <div class="qf" data-qp-confirmed>
      <div class="qf-counter" data-qf-counter hidden aria-live="polite">
        <div class="qf-bar"><i data-qf-bar></i></div>
        <b data-qf-count></b>
      </div>
      <div class="qf-invite" data-qf-invite hidden>
        <b class="qf-sent-title">{t.inviteTitle}</b>
        <p class="pub-text">{t.inviteText}</p>
        <output class="qf-link" data-qf-link></output>
        <div class="pub-actions">
          <button type="button" class="btn l" data-qf-share>{t.inviteShare}</button>
          <button type="button" class="btn g" data-qf-copy>{t.copy}</button>
        </div>
      </div>
    </div>
    <a class="btn w" href={localePath(locale, '/quiz/')}>{quizCopy[locale].quiz.result.cardKicker}</a>
  </section>

  <section class="pub-state" data-state="unsubscribed" hidden>
    <img class="pub-pet" src="/img/m/nino_coucou.webp" alt="" width="450" height="500" />
    <h1 class="pub-title" tabindex="-1">{t.unsubTitle}</h1>
    <p class="pub-text">{t.unsubText}</p>
  </section>

  <section class="pub-state" data-state="link_failed" hidden>
    <img class="pub-pet" src="/img/nino_triste.webp" alt="" width="900" height="1000" />
    <p class="pub-text">{t.confirmFail}</p>
    <div class="pub-actions"><a class="btn l" href={localePath(locale, '/quartier/')}>{t.submit}</a></div>
  </section>
<style is:global>
.qp-pet{width:min(420px,86%);height:auto}
.qp-zone{font-family:var(--display);font-weight:800;font-size:28px;color:var(--lime)}
.qp-zone:empty{display:none}
</style>
