---
/**
 * Image d'un minimoa en pied (450×500 par défaut, toile 9:10 du pack). Sans `alt`, l'image est décorative.
 * `sizes` (largeur affichée) active le `srcset` des versions réduites quand elles existent (lib/img.ts).
 */
import { responsive } from '../../lib/img';
interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  sizes?: string;
  class?: string;
  id?: string;
  [attr: `data-${string}`]: string | undefined;
}
const { src, alt = '', width = 450, height = 500, loading, fetchpriority, decoding = 'async', class: cls, sizes, ...rest } = Astro.props;
const rsp = sizes ? responsive(src, sizes) : {};
---
<img class={cls} src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding={decoding} {...rsp} {...rest} />
