---
/** 1. Hero : titre, bulles, boutons de store, nino qui salue sur sa colline. */
import Sticker from '../../atoms/Sticker.astro';
import PetImage from '../../atoms/PetImage.astro';
import ChatBubble from '../../molecules/ChatBubble.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import StoreButtons from '../../molecules/StoreButtons.astro';
import { hero, sections } from '../../../content/landing';
---
<SnapSection section={sections.top} panel="p-lime hero" light>
  <div class="hb-top">
    <ChatBubble bubble={hero.bubbles.b1} class="b1" />
    <ChatBubble bubble={hero.bubbles.b2} class="b2" />
  </div>
  <SectionTitle lines={hero.title} level={1} />
  <div class="hcta" data-r="up">
    <StoreButtons />
    <p class="tag">{hero.tag}</p>
  </div>
  <div class="hstage">
    <div class="hill" aria-hidden="true"></div>
    <div class="hpet" data-r="pop"><div class="bob" style="height:100%"><PetImage src={hero.pet.src} alt={hero.pet.alt} /></div></div>
    <ChatBubble bubble={hero.bubbles.b3} class="b3" />
  </div>
  <Sticker class="s1" src="/img/ic_etoiles.webp" reveal />
  <Sticker class="s2" src="/img/ic_coeurs.webp" reveal />
</SnapSection>
<style is:global>
.hero{grid-template-rows:auto auto auto minmax(0,1fr);text-align:center;justify-items:center}
.hero .hd{--k:14;--hs:13svh;--hmax:150px}
.hb-top{display:flex;flex-direction:column;gap:6px;width:100%}
.hb-top .b2{align-self:flex-end}
.hcta{display:flex;flex-direction:column;align-items:center;gap:8px}
.hstage{position:relative;width:100%;height:100%;min-height:0}
.hpet{position:absolute;left:50%;bottom:-6%;height:112%;translate:-50% 0;transform-origin:50% 100%}
.hpet img{height:100%;width:auto;max-width:none;filter:drop-shadow(0 18px 24px rgba(20,16,31,.35))}
.hero .b3{position:absolute;right:0;top:0;z-index:2}
.hero .s1{position:absolute;left:4%;top:8%;width:clamp(40px,6svh,70px)}
.hero .s2{position:absolute;right:6%;top:6%;width:clamp(38px,5.5svh,64px)}
@media (min-width:900px){
  .hero{grid-template-rows:auto;align-content:start}
  .hb-top{display:contents}
  .hero .bub{position:absolute;z-index:2}
  .hero .b1{left:6%;top:47%}
  .hero .b2{left:12%;top:63%}
  .hero .b3{right:6%;top:52%}
  .hcta{position:absolute;right:var(--px);bottom:var(--py);align-items:flex-end;z-index:3}
  .hstage{position:absolute;left:0;right:0;bottom:0;height:54%}
  .hero .s1{left:8%;top:14%}
  .hero .s2{right:9%;top:16%}
}
</style>
