---
/** 9. Rencontres : deux minimoas qui se tapent dans la main, le pourquoi (points communs, une différence), rien sans ton tap. */
import Button from '../../atoms/Button.astro';
import ChatBubble from '../../molecules/ChatBubble.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import { DUO, sections } from '../../../content/landing';
import type { Locale } from '../../../i18n/site';
import { landingText } from '../../../content/landing-text';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = landingText[locale].encounters;
const m1 = { who: 'Pia', text: c.m1, avatar: { img: '/img/pia_face.webp' } };
const m2 = { who: 'Nino', text: c.m2, avatar: { img: '/img/nino_face.webp' }, me: true };
---
<SnapSection section={sections.rencontres} panel="p-coral s-meet">
  <SectionTitle lines={c.title}>
    <p class="lead" data-r="up">{c.lead}</p>
  </SectionTitle>
  <div class="mstage">
    <div class="mduo" data-r="pop"><div class="bob"><img src={DUO.src} alt={c.duoAlt} width={DUO.width} height={DUO.height} loading="lazy" decoding="async" /></div></div>
    <ChatBubble bubble={m1} class="m1" />
    <ChatBubble bubble={m2} class="m2" />
  </div>
  <div class="mwhy" data-r="up">
    <span class="lbl">{c.why.label}</span>
    <ul role="list">{c.why.common.map((w) => <li>{w}</li>)}</ul>
    <p>{c.why.diff}</p>
  </div>
  <div class="mcta" data-r="up">
    <span class="lbl">{c.ctaLabel}</span>
    <div class="btns"><Button variant="w" href="#go">{c.yes}</Button><Button variant="g" href="#go">{c.no}</Button></div>
  </div>
</SnapSection>
<style is:global>
.s-meet{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto auto;grid-template-areas:"tx" "stage" "why" "cta"}
.s-meet .tx{grid-area:tx}
.s-meet .hd{--k:14}
.mstage{grid-area:stage;position:relative;min-height:0;display:flex;justify-content:center;align-items:flex-end}
.mduo{height:100%;max-height:420px;aspect-ratio:700/456;max-width:100%;display:flex;align-items:flex-end}
.mduo .bob{width:100%}
.mduo img{width:100%;height:auto;filter:drop-shadow(0 18px 22px rgba(80,10,0,.3))}
.mstage .bub{position:absolute;z-index:2;max-width:64%;display:none}
.mstage .m1{left:0;top:0}
.mstage .m2{right:0;top:20%}
.mwhy{grid-area:why;background:#fff;color:var(--ink);border-radius:20px;padding:10px 14px}
.mwhy .lbl{color:var(--coral)}
.mwhy ul{list-style:none;margin:6px 0 4px;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.mwhy li{font-size:12.5px;font-weight:800;padding:5px 10px;border-radius:999px;background:#FFE7E1}
.mwhy p{font-size:12.5px;font-weight:600;color:var(--mute-d)}
.mcta{grid-area:cta;display:flex;flex-direction:column;gap:8px}
.mcta .lbl{opacity:.85}
.btns{display:flex;gap:8px;flex-wrap:nowrap}
@media (max-width:899px){.btns .btn{padding:0 16px}}
@media (max-width:899px) and (max-height:760px){.mwhy p{display:none}}
@media (min-width:900px){
  .s-meet{grid-template-columns:1fr 1.1fr;grid-template-rows:1fr auto auto auto 1fr;grid-template-areas:". stage" "tx stage" "why stage" "cta stage" ". stage";column-gap:3vw;row-gap:2svh;align-items:center}
  .mstage{height:100%;align-items:center}
  .mstage .bub{display:flex;max-width:300px}
  .mduo{height:auto;width:100%;max-height:none;max-width:640px}
  .mstage .m1{left:0;top:6%;width:min(290px,48%)}
  .mstage .m2{right:0;top:18%;width:min(290px,48%)}
  .mstage .bub p{flex:1}
  .mwhy{max-width:520px;padding:14px 18px}
  .mwhy li{font-size:14px}
  .mwhy p{font-size:14px}
}
</style>
