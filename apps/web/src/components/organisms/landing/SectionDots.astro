---
/** Points de navigation verticaux (grand écran). `skip` : sections absentes de la page. */
import { nav, sectionOrder, sections, type SectionId } from '../../../content/landing';
interface Props {
  skip?: SectionId[];
}
const { skip = [] } = Astro.props;
---
<nav class="dots" aria-label={nav.dotsLabel}>
  {sectionOrder.filter((id) => !skip.includes(id)).map((id) => <a href={`#${sections[id].id}`} aria-label={sections[id].dot}></a>)}
</nav>
