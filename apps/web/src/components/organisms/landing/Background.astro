---
/** Calque de fond fixe : halos colorés (suivent la section active), étoiles, autocollants qui dérivent. */
const drifts = ['ic_etoiles', 'ic_eclair', 'ic_balle', 'ic_cadeau', 'ic_confettis', 'ic_piece'];
---
<div class="bgx" aria-hidden="true">
  <canvas class="halo"></canvas>
  <div class="stars"></div>
  {drifts.map((d, i) => <img class={`drift d${i + 1} stk`} src={`/img/${d}.webp`} alt="" />)}
</div>
