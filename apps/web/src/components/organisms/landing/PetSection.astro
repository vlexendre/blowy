---
/** 2. Il est vivant : choisir son minimoa, puis un soin = une pose en pied (une seule image, changée par le script). */
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import { alive as c, IMG, sections } from '../../../content/landing';
const first = c.species.find((s) => s.key === c.initial) ?? c.species[0]!;
---
<SnapSection section={sections.pet} panel="p-night s-pet">
  <SectionTitle lines={c.title}>
    <p class="lead hide-short" data-r="up">{c.lead}</p>
  </SectionTitle>
  <div class="astage" data-r="pop">
    <div class="aglow" aria-hidden="true"></div>
    <div class="bob">
      <img id="apet" src={`${IMG}/${first.key}_${c.rest.pose}.webp`} alt={first.alt} width="450" height="500" loading="lazy" decoding="async" data-species={first.key} />
    </div>
    <p class="asay" aria-live="polite"><span id="asay">{c.rest.say}</span></p>
  </div>
  <div class="actl" data-r="up">
    <div class="aspecies" role="group" aria-label={c.speciesLabel}>
      {
        c.species.map((s) => (
          <button type="button" data-s={s.key} data-alt={s.alt} data-name={s.name} aria-pressed={s.key === first.key ? 'true' : 'false'}>
            <img src={`/img/${s.key}_face.webp`} alt="" width="40" height="40" loading="lazy" />
            <span>{s.name}</span>
          </button>
        ))
      }
    </div>
    <div class="acare" role="group" aria-label={c.careLabel}>
      {
        c.actions.map((a) => (
          <button type="button" data-pose={a.pose} data-say={a.say} data-label={a.label} aria-pressed="false">
            <img src={`${IMG}/${a.icon}.webp`} alt="" width="40" height="40" loading="lazy" />
            <span>{a.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</SnapSection>
<style is:global>
.s-pet{grid-template-rows:auto minmax(0,1fr) auto;grid-template-areas:"tx" "stage" "ctl"}
.s-pet .tx{grid-area:tx}
.s-pet .hd{--k:12}
.astage{grid-area:stage;position:relative;min-height:0;display:flex;justify-content:center;align-items:flex-end}
.aglow{position:absolute;left:50%;bottom:0;translate:-50% 30%;width:min(92%,62svh);aspect-ratio:1;border-radius:50%;background:radial-gradient(closest-side,rgba(255,184,0,.32),rgba(109,61,240,.18) 60%,transparent)}
.astage .bob{position:relative;height:100%;max-height:min(520px,52svh);aspect-ratio:9/10}
.astage img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 24px rgba(0,0,0,.45));transition:opacity .2s}
.asay{position:absolute;left:0;top:4%;z-index:2;max-width:56%;background:#fff;color:var(--ink);font-weight:700;font-size:clamp(13px,1.9svh,17px);line-height:1.25;padding:9px 14px;border-radius:20px 20px 20px 6px;box-shadow:0 10px 24px rgba(0,0,0,.25)}
.actl{grid-area:ctl;display:flex;flex-direction:column;gap:10px}
.aspecies{display:flex;gap:6px}
.aspecies button{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 8px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid var(--line);font-weight:800;font-size:13px;transition:background .2s,border-color .2s}
.aspecies img{width:28px;height:28px;border-radius:50%;background:#fff;flex:0 0 auto}
.aspecies button[aria-pressed="true"]{background:#fff;color:var(--ink);border-color:#fff}
.acare{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
.acare button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:62px;border-radius:18px;background:rgba(255,255,255,.07);border:1px solid var(--line);font-weight:700;font-size:11.5px;transition:transform .2s,background .2s}
.acare img{width:30px;height:30px;object-fit:contain}
.acare button:hover{transform:translateY(-2px)}
.acare button[aria-pressed="true"]{background:var(--lime);color:var(--ink);border-color:var(--lime)}
@media (max-width:420px){.aspecies span{display:none}.aspecies img{width:32px;height:32px}}
@media (min-width:900px){
  .s-pet{grid-template-columns:1fr 1fr;grid-template-rows:1fr auto auto 1fr;grid-template-areas:". stage" "tx stage" "ctl stage" ". stage";column-gap:4vw;align-items:center}
  .astage{height:100%;align-items:center}
  .astage .bob{max-height:min(640px,70svh)}
  .asay{top:10%;left:2%;max-width:44%}
  .actl{margin-top:2svh;max-width:560px;gap:14px}
  .aspecies button{font-size:15px;min-height:52px}
  .aspecies img{width:34px;height:34px}
  .acare{grid-template-columns:repeat(3,1fr);gap:10px}
  .acare button{flex-direction:row;gap:10px;min-height:56px;font-size:15px;justify-content:flex-start;padding:0 16px}
  .acare img{width:34px;height:34px}
}
@media (max-width:899px) and (max-height:760px){.acare button{min-height:52px}.acare img{width:24px;height:24px}}
</style>
