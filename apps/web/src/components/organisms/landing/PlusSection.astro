---
/** 9. Blowy+ : gratuit contre blowy+. */
import Button from '../../atoms/Button.astro';
import PetImage from '../../atoms/PetImage.astro';
import Sticker from '../../atoms/Sticker.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import { plus as c, sections } from '../../../content/landing';
---
<SnapSection section={sections.plus} panel="p-night s-plus">
  <SectionTitle lines={c.title}>
    <p class="lead hide-short" data-r="up">{c.lead}</p>
  </SectionTitle>
  <div class="plans">
    <div class="plan free" data-r="card">
      <h3>{c.free.name} <small>{c.free.note}</small></h3>
      <ul>{c.free.items.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="plan pro" data-r="card">
      <h3>{c.pro.name} <small>{c.pro.note}</small></h3>
      <ul>{c.pro.items.map((i) => <li>{i}</li>)}</ul>
      <div class="price"><b>{c.pro.price}</b><span>{c.pro.priceNote}</span></div>
      <Button variant="l" href="#go">{c.pro.cta}</Button>
      <Sticker class="gel" src="/img/ic_gel.webp" />
    </div>
  </div>
  <PetImage class="gas" src="/img/gaston_smug.webp" loading="lazy" />
</SnapSection>
<style is:global>
.s-plus{grid-template-rows:auto minmax(0,1fr);grid-template-areas:"tx" "plans"}
.s-plus .tx{grid-area:tx}
.s-plus .hd{--k:11}
.plans{grid-area:plans;display:flex;flex-direction:column;gap:10px;min-height:0}
.plan{border-radius:22px;padding:clamp(12px,1.9svh,26px);background:rgba(255,255,255,.05);border:1px solid var(--line);position:relative}
.plan h3{font-family:var(--display);font-weight:400;font-size:clamp(22px,3.2svh,38px);line-height:1;text-transform:uppercase;display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.plan h3 small{font-family:var(--body);font-size:13px;font-weight:700;color:var(--mute);text-transform:none}
.plan ul{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:5px;font-size:var(--ts);font-weight:600}
.plan li{display:flex;gap:8px;align-items:baseline}
.plan li::before{content:"";flex:0 0 auto;width:7px;height:7px;border-radius:50%;background:var(--mute);translate:0 -1px}
.plan.free ul{grid-template-columns:1fr 1fr;column-gap:12px}
.plan.pro{background:linear-gradient(160deg,rgba(255,184,0,.16),rgba(109,61,240,.18));border:2px solid var(--lime)}
.plan.pro h3{color:var(--lime)}
.plan.pro li::before{background:var(--lime)}
.price{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;margin-top:10px}
.price b{font-family:var(--display);font-weight:400;font-size:clamp(28px,4.4svh,54px);line-height:1}
.price span{font-size:12px;color:var(--mute);font-weight:600}
.plan .btn{margin-top:10px;height:46px}
.plan .gel{position:absolute;right:14px;top:-16px;width:clamp(40px,6svh,70px);rotate:10deg}
.s-plus .gas{display:none}
@media (min-width:900px){
  .s-plus{grid-template-columns:.95fr 1.25fr;grid-template-rows:minmax(0,1fr);grid-template-areas:"tx plans";column-gap:4vw;align-items:center}
  .plans{flex-direction:row;align-items:stretch}
  .plan{flex:1;display:flex;flex-direction:column}
  .plan.free ul{grid-template-columns:1fr}
  .plan ul{gap:10px;margin-top:16px}
  .plan .btn{margin-top:auto}
  .price{margin:18px 0 16px}
  .s-plus .gas{display:block;position:absolute;left:3%;bottom:-6%;width:min(24svh,240px);rotate:6deg}
  .s-plus .tx{align-self:start;padding-top:2svh}
}
@media (max-width:899px) and (max-height:760px){.plan{padding:12px 14px}.plan ul{gap:3px;margin-top:6px}.price{margin-top:6px}.plan .btn{margin-top:8px;height:44px}}
</style>
