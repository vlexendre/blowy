---
/** 11. Final : « ton pet t'attend », la bande au complet, et le pied de page. */
import Sticker from '../../atoms/Sticker.astro';
import PetImage from '../../atoms/PetImage.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import StoreButtons from '../../molecules/StoreButtons.astro';
import SiteFooter from '../SiteFooter.astro';
import { final as c, sections } from '../../../content/landing';
---
<SnapSection section={sections.go} panel="p-lime s-go" light class="last">
  <SectionTitle lines={c.title} />
  <StoreButtons reveal />
  <div class="gstage" data-r="pop">
    <div class="hill" aria-hidden="true"></div>
    <div class="bob"><PetImage src={c.band.src} alt={c.band.alt} width={1650} height={750} loading="lazy" /></div>
  </div>
  <Sticker class="s4" src="/img/ic_cadeau.webp" reveal />
  <Sticker class="s5" src="/img/ic_confettis.webp" reveal />
  <SiteFooter slot="after" logoHref="#top" />
</SnapSection>
<style is:global>
.sec.last{display:flex;flex-direction:column;gap:8px}
.sec.last .panel{flex:1;min-height:0;width:100%}
.s-go{grid-template-rows:auto auto minmax(0,1fr);text-align:center;justify-items:center}
.s-go .hd{--k:15;--hs:11svh;--hmax:140px}
.s-go .stores{justify-content:center}
.gstage{position:relative;width:100%;min-height:0}
.gstage .hill{width:min(140%,calc(100svh * .9));translate:-50% 62%}
.gstage .bob{position:absolute;left:50%;bottom:-8%;translate:-50% 0;height:118%;max-width:120%;aspect-ratio:1650/750;transform-origin:50% 100%}
.gstage .bob img{width:100%;height:100%;object-fit:contain}
@media (max-width:899px){.gstage .bob{bottom:-3%;max-width:135%}.gstage .hill{translate:-50% 70%}}
.s-go .s4{position:absolute;left:6%;top:10%;width:clamp(40px,6svh,72px)}
.s-go .s5{position:absolute;right:6%;top:12%;width:clamp(40px,6svh,72px)}
@media (min-width:900px){.s-go .stores{margin-top:4px}}
@media (max-width:899px){.s-go .s4{top:46%;left:5%}.s-go .s5{top:44%;right:5%}}
</style>
