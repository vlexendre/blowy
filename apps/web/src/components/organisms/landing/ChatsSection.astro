---
/** 4. Il vit dans tes chats : téléphone avec la conversation et cartes d'apps. */
import Sticker from '../../atoms/Sticker.astro';
import PhoneFrame from '../../molecules/PhoneFrame.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import { chats as c, sections } from '../../../content/landing';
const p = c.phone;
---
<SnapSection section={sections.chats} panel="p-rose s-chat" light>
  <SectionTitle lines={c.title}>
    <p class="lead" data-r="up">{c.lead} <b class="hide-short">{c.leadBold}</b></p>
  </SectionTitle>
  <PhoneFrame>
    <div class="ph-h"><span class="avs"><img src="/img/nino_face.webp" alt="" /><img src="/img/suzie_face.webp" alt="" /></span><b>{p.name}</b><span class="hz">{p.status}</span></div>
    <div class="tabs">{p.tabs.map((t, i) => <span class={i === p.activeTab ? 'on' : undefined}>{t}</span>)}</div>
    <div class="feed">
      {
        p.messages.map((m) =>
          m.kind === 'pet' ? (
            <div class="m pet" data-r="msg">
              <img src={`/img/${m.pet}_face.webp`} alt="" />
              <div style={m.border ? `border-color:${m.border}` : undefined}><span class="n" style={`color:${m.color}`}>{m.who}</span>{m.text}</div>
            </div>
          ) : m.kind === 'me' ? (
            <div class="m me">{m.text}</div>
          ) : (
            <div class="m"><span class="n" style="color:var(--rose)">{m.who}</span>{m.text}</div>
          ),
        )
      }
      <div class="mini" data-r="msg"><img src="/img/ic_flamme.webp" alt="" />{p.mini}</div>
    </div>
    <div class="inp"><i>+</i><span>{p.input}</span><i>🎙</i></div>
  </PhoneFrame>
  <div class="apps">
    {
      c.apps.map((a) => (
        <div class:list={['app', { 'hide-short': a.short }]} data-r="card">
          <span class="lbl">{a.label}</span>
          <h4>{a.title}</h4>
          {a.big && <span class="big">{a.big}</span>}
          {a.bar && <div class="bar"><i></i></div>}
          <p>{a.text}</p>
          <Sticker class="ico" src={`/img/${a.icon}.webp`} />
        </div>
      ))
    }
  </div>
</SnapSection>
<style is:global>
.s-chat{grid-template-columns:60% 1fr;grid-template-rows:auto minmax(0,1fr);grid-template-areas:"tx tx" "phone apps";column-gap:0}
.s-chat .tx{grid-area:tx}
.s-chat .hd{--k:8}
.phone{grid-area:phone;position:relative;min-height:0;background:var(--ink);border-radius:30px;padding:7px;box-shadow:0 24px 50px rgba(20,16,31,.35);rotate:-2deg;transform-origin:50% 100%;max-width:340px;width:100%;justify-self:center}
.scr{height:100%;border-radius:24px;background:#100D1C;color:#fff;display:flex;flex-direction:column;overflow:hidden;font-size:12px}
.ph-h{display:flex;align-items:center;gap:8px;padding:12px 12px 8px;border-bottom:1px solid rgba(255,255,255,.07)}
.ph-h .avs img{width:28px;height:28px}
.ph-h b{font-size:14px;font-weight:800;flex:1}
.ph-h .hz{font-size:11px}
.tabs{display:flex;gap:4px;padding:6px 10px;font-size:10.5px;font-weight:700;color:var(--mute)}
.tabs span{padding:4px 8px;border-radius:999px}
.tabs .on{background:rgba(255,255,255,.1);color:#fff}
.feed{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:flex-end;gap:7px;padding:8px 10px;overflow:hidden}
.m{max-width:86%;padding:7px 10px;border-radius:16px 16px 16px 5px;background:#2A2542;line-height:1.3}
.m .n{display:block;font-size:10px;font-weight:800;margin-bottom:1px}
.m.me{align-self:flex-end;background:var(--lime);color:var(--ink);border-radius:16px 16px 5px 16px}
.m.pet{display:flex;gap:6px;align-items:flex-end;background:none;padding:0}
.m.pet img{width:24px;height:24px;border-radius:50%;flex:0 0 auto;background:#fff}
.m.pet div{background:#221B3D;border:1px solid rgba(255,184,0,.35);padding:7px 10px;border-radius:16px 16px 16px 5px}
.mini{align-self:center;display:flex;align-items:center;gap:8px;background:#fff;color:var(--ink);border-radius:14px;padding:6px 10px;font-weight:800;font-size:11px}
.mini img{width:20px;height:20px}
.inp{display:flex;align-items:center;gap:8px;padding:8px 10px 10px}
.inp span{flex:1;height:30px;border-radius:999px;background:rgba(255,255,255,.08);display:flex;align-items:center;padding:0 12px;color:var(--mute);font-size:11px}
.inp i{width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-style:normal;font-weight:800}
.apps{grid-area:apps;position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;gap:clamp(8px,1.6svh,18px);margin-left:-10px;min-height:0}
.app{background:#fff;color:var(--ink);border-radius:18px;padding:10px 12px;box-shadow:0 14px 30px rgba(20,16,31,.22);position:relative}
.app:nth-child(1){rotate:4deg}.app:nth-child(2){rotate:-3deg;margin-left:8px}.app:nth-child(3){rotate:3deg}
.app .lbl{font-size:9px;color:rgba(20,16,31,.55)}
.app h4{margin:2px 0 4px;font-family:var(--display);font-weight:400;font-size:clamp(15px,2.3svh,26px);line-height:1;text-transform:uppercase}
.app p{font-size:11px;font-weight:600;color:var(--mute-d)}
.app .big{font-family:var(--display);font-size:clamp(22px,3.4svh,40px);line-height:1}
.app .bar{height:8px;border-radius:999px;background:#F0ECF7;margin:6px 0 4px;overflow:hidden}
.app .bar i{display:block;height:100%;width:60%;border-radius:999px;background:var(--orange)}
.app .ico{position:absolute;right:-10px;top:-12px;width:clamp(30px,4.4svh,48px)}
@media (min-width:900px){
  .s-chat{grid-template-columns:1fr auto 1fr;grid-template-rows:minmax(0,1fr);grid-template-areas:"tx phone apps";column-gap:4vw;align-items:center}
  .phone{height:100%;max-height:640px;width:auto;aspect-ratio:9/17;max-width:none;align-self:center}
  .scr{font-size:13.5px}
  .m .n{font-size:11px}
  .apps{margin-left:0;max-width:300px}
  .app{padding:14px 16px}
  .app p{font-size:13px}
  .app .lbl{font-size:10px}
}
</style>
