---
/** 6. Groupes : un groupe d'habitude (vies, série, état du jour de chacun, joker), « la tenir ensemble », un groupe libre. */
import LifeSpark from '../../atoms/LifeSpark.astro';
import SectionTitle from '../../molecules/SectionTitle.astro';
import SnapSection from '../../molecules/SnapSection.astro';
import { groups as c, sections } from '../../../content/landing';
const g = c.card;
const sparks = Array.from({ length: g.livesMax }, (_, i) => i >= g.lives);
---
<SnapSection section={sections.groupes} panel="p-violet s-grp">
  <SectionTitle lines={c.title}>
    <p class="lead" data-r="up">{c.lead}</p>
  </SectionTitle>
  <div class="gcol">
    <div class="gcard" data-r="card">
      <div class="gh">
        <span class="he" aria-hidden="true">{g.emoji}</span>
        <b>{g.name}</b>
        <span class="gsp" role="img" aria-label={`${g.lives} vies sur ${g.livesMax}`}>{sparks.map((off) => <LifeSpark off={off} />)}</span>
      </div>
      <div class="gst"><b>{g.streak}</b><span>{g.streakUnit}</span><em>{g.today}</em></div>
      <ul class="gm" role="list">
        {
          g.members.map((m) => (
            <li>
              <img src={`/img/${m.pet}_face.webp`} alt="" width="36" height="36" loading="lazy" />
              <b>{m.name}</b>
              <span class={m.tone}>{m.state}</span>
            </li>
          ))
        }
      </ul>
      <p class="gnote hide-short">{g.note}</p>
    </div>
    <div class="gtog" data-r="card">
      <span class="lbl">{c.together.label}</span>
      <p>{c.together.text}</p>
      <small class="hide-short">{c.together.note}</small>
    </div>
    <div class="gfree hide-short" data-r="card">
      <span class="avs"><img src="/img/gaston_face.webp" alt="" width="30" height="30" loading="lazy" /><img src="/img/pia_face.webp" alt="" width="30" height="30" loading="lazy" /><img src="/img/nino_face.webp" alt="" width="30" height="30" loading="lazy" /></span>
      <span><b>{c.free.name}</b><small>{c.free.kind} · {c.free.text}</small></span>
    </div>
  </div>
</SnapSection>
<style is:global>
.s-grp{grid-template-rows:auto minmax(0,1fr);grid-template-areas:"tx" "col"}
.s-grp .tx{grid-area:tx}
.s-grp .hd{--k:12}
.gcol{grid-area:col;display:flex;flex-direction:column;gap:8px;min-height:0;justify-content:center}
.gcard{background:var(--ink);border-radius:22px;padding:12px 14px;box-shadow:0 18px 40px rgba(20,10,60,.35)}
.gh{display:flex;align-items:center;gap:10px}
.gh .he{font-size:20px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:rgba(255,255,255,.08)}
.gh b{flex:1;font-weight:800;font-size:16px}
.gsp{display:flex;gap:3px}
.gsp svg{width:18px;height:auto;overflow:visible}
.gsp .f{fill:var(--lime)}
.gsp .o{fill:none;stroke:rgba(255,255,255,.35);stroke-width:2}
.gsp svg.off .f{fill:transparent}
.gst{display:flex;align-items:baseline;gap:6px;margin:8px 0 6px;flex-wrap:wrap}
.gst b{font-family:var(--display);font-weight:400;font-size:30px;line-height:1;color:var(--lime)}
.gst span{font-size:12px;font-weight:700;color:var(--mute)}
.gst em{margin-left:auto;font-style:normal;font-size:12px;font-weight:800}
.gm{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.gm li{display:flex;align-items:center;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.07)}
.gm img{width:30px;height:30px;border-radius:50%;background:#fff}
.gm b{flex:1;font-weight:700;font-size:14px}
.gm span{font-size:12px;font-weight:800;padding:4px 10px;border-radius:999px}
.gm .ok{background:var(--lime);color:var(--ink)}
.gm .joker{background:#6FB7FF;color:var(--ink)}
.gm .wait{background:rgba(255,255,255,.1);color:var(--mute)}
.gnote{font-size:12px;color:var(--mute);margin-top:6px}
@media (max-width:899px){.gfree,.gnote,.gtog small{display:none}}
.gtog{background:#fff;color:var(--ink);border-radius:20px;padding:10px 14px;rotate:-1.5deg}
.gtog .lbl{color:var(--violet-d)}
.gtog p{font-weight:800;font-size:15px;line-height:1.25;margin-top:2px}
.gtog small{display:block;font-size:11.5px;font-weight:600;color:var(--mute-d);margin-top:4px}
.gfree{display:flex;align-items:center;gap:10px;background:rgba(20,16,31,.3);border:1px solid rgba(255,255,255,.2);border-radius:18px;padding:8px 12px}
.gfree .avs img{width:30px;height:30px;border-radius:50%;background:#fff;border:2px solid var(--violet-d)}
.gfree .avs img+img{margin-left:-10px}
.gfree b{display:block;font-weight:800;font-size:14px}
.gfree small{display:block;font-size:11.5px;opacity:.8}
@media (min-width:900px){
  .s-grp{grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr);grid-template-areas:"tx col";column-gap:5vw;align-items:center}
  .gcol{gap:14px;max-width:520px;width:100%;justify-self:center}
  .gcard{padding:18px 20px}
  .gh b{font-size:19px}
  .gst b{font-size:40px}
  .gm b{font-size:16px}
  .gtog{padding:14px 18px}
  .gtog p{font-size:17px}
}
</style>
