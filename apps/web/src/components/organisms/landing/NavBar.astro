---
/** Barre de navigation flottante (pilule en verre) : ancres des sections, langue, « télécharger ». */
import Logo from '../../atoms/Logo.astro';
import LangSwitch from '../../molecules/LangSwitch.astro';
import { NAV_LINKS } from '../../../content/landing';
import { landingText } from '../../../content/landing-text';
import { siteText } from '../../../content/site';
import type { Locale } from '../../../i18n/site';
interface Props {
  locale: Locale;
  langLinks: { locale: Locale; href: string }[];
}
const { locale, langLinks } = Astro.props;
const t = landingText[locale].nav;
---
<header class="nav">
  <div class="pill">
    <Logo href="#top" label={t.logoLabel} />
    <nav class="links" aria-label={t.sectionsLabel}>
      {NAV_LINKS.map((l) => <a href={`#${l}`} data-nav={l}>{t.links[l]}</a>)}
    </nav>
    <LangSwitch locale={locale} links={langLinks} />
    <a class="dl" href="#go"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M5 19h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{siteText[locale].download}</a>
  </div>
</header>
