---
/** Un code à taper à l'inscription (« Un code ? »), avec « Copier ». Rempli par le script de la page. */
interface Props {
  label: string;
  help: string;
  copy: string;
  /** Caché tant qu'aucun code n'est connu. */
  hidden?: boolean;
  box?: string;
}
const { label, help, copy, hidden = false, box } = Astro.props;
const id = `code-label-${box ?? 'main'}`;
---
<div class="code-box" data-code-box={box ?? 'main'} hidden={hidden}>
  <span class="lbl" id={id} data-t="codeLabel">{label}</span>
  <div class="code-row">
    <output class="code" aria-labelledby={id} data-code></output>
    <button type="button" class="btn g code-copy" data-copy data-t="copy">{copy}</button>
  </div>
  <p class="pub-text" data-t="codeHelp">{help}</p>
</div>
<style is:global>
.code-box{width:100%;margin-top:6px;padding:16px;border-radius:22px;background:rgba(255,255,255,.05);border:1px dashed rgba(255,255,255,.25);display:flex;flex-direction:column;gap:8px}
.code-box[hidden]{display:none}
.code-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.code{font-family:var(--display);font-size:clamp(30px,9vw,44px);letter-spacing:.08em;color:var(--lime);line-height:1;overflow-wrap:anywhere;user-select:all}
.pub .code-copy{height:44px;font-size:14px}
.code-box .pub-text{font-size:14px}
</style>
