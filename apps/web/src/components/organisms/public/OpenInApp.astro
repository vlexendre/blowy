---
/**
 * Page « Ouvre Minimoa » (/plus, /defi, /habitudes, /carte, /r/…, /l/…) : une adresse, cinq langues, celle du téléphone
 * montrée (layouts/Public.astro, mode `shell`). Aperçu de lien en français (les robots d'aperçu ne lancent pas de script).
 */
import Public from '../../../layouts/Public.astro';
import OpenState from './OpenState.astro';
import { openCopy, type OpenKind } from '../../../content/open';
import type { Locale } from '../../../i18n/site';

interface Props {
  kind: OpenKind;
}
const { kind } = Astro.props;
---
<Public
  shell="always"
  noindex
  ogImage={`/og/${kind}.jpg`}
  meta={(l) => ({ title: openCopy[l].kinds[kind].meta, description: openCopy[l].description, ogAlt: openCopy[l].kinds[kind].title.join(' ') })}
>
  {(l: Locale) => <OpenState locale={l} kind={kind} />}
</Public>
