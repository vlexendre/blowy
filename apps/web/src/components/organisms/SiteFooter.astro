---
/**
 * Pied de page : logo, liens d'aide et légaux (pages légales de la même langue), langues de la page, copyright. En
 * français, en plus : « Villes » et « Guides » (pages éditoriales) ; en néerlandais : « Vrienden maken ».
 */
import Logo from '../atoms/Logo.astro';
import LangSwitch from '../molecules/LangSwitch.astro';
import { siteText } from '../../content/site';
import { legalPath } from '../../i18n/legal';
import { localePath, type Locale } from '../../i18n/site';
import { editorialUi } from '../../content/editorial/ui';
import { vriendenMaken } from '../../content/editorial/nl/vrienden-maken';

interface Props {
  locale: Locale;
  logoHref?: string;
  class?: string;
  /** liens (pages légales) ; par défaut aide, mentions, conditions, confidentialité et sommaire, dans la langue */
  links?: readonly { href: string; label: string }[];
  /** aria-label de la navigation */
  label?: string;
  /** la même page dans chaque langue (pages indexées) */
  langLinks?: { locale: Locale; href: string }[];
}
const { locale, logoHref = localePath(locale, '/'), class: cls, langLinks } = Astro.props;
const t = siteText[locale].footer;
const links =
  Astro.props.links ??
  (['assistance', 'mentions-legales', 'conditions', 'confidentialite', 'index'] as const).map((s) => ({
    href: s === 'index' ? legalPath(locale) : legalPath(locale, s),
    label: t.links[s],
  }));
const label = Astro.props.label ?? t.label;
---
<footer class:list={['foot', cls]}>
  <Logo href={logoHref} />
  <nav aria-label={label}>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  {
    locale === 'fr' && (
      <nav aria-label={editorialUi.footer.label}>
        <a href={editorialUi.cities.path}>{editorialUi.footer.cities}</a>
        <a href={editorialUi.guides.path}>{editorialUi.footer.guides}</a>
        <a href={editorialUi.blog.path}>{editorialUi.footer.blog}</a>
      </nav>
    )
  }
  {
    locale === 'nl' && (
      <nav aria-label={vriendenMaken.ui.footer.label}>
        <a href={vriendenMaken.path}>{vriendenMaken.ui.footer.link}</a>
      </nav>
    )
  }
  {langLinks && langLinks.length > 1 && <LangSwitch locale={locale} links={langLinks} variant="inline" />}
  <span>© 2026 Minimoa</span>
</footer>
<style is:global>
.foot{flex:0 0 auto;position:relative;z-index:2;background:var(--bg);border-radius:16px;padding:0 10px;max-width:1600px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:4px 14px;flex-wrap:wrap;font-size:13px;color:var(--mute)}
.foot .logo{font-size:22px;color:#fff;min-height:0}
.foot nav{display:flex;gap:2px;flex-wrap:wrap}
.foot nav a{display:flex;align-items:center;min-height:44px;padding:0 8px;border-radius:10px}
.foot nav a:hover{color:#fff}
@media (min-width:900px){.foot{padding:0 8px}}
</style>
