---
/** Pied de page : logo, liens d'aide et légaux, copyright. */
import Logo from '../atoms/Logo.astro';
import { footer } from '../../content/landing';
interface Props {
  logoHref?: string;
  class?: string;
}
const { logoHref = '/', class: cls } = Astro.props;
---
<footer class:list={['foot', cls]}>
  <Logo href={logoHref} />
  <nav aria-label={footer.legalLabel}>
    {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <span>{footer.copyright}</span>
</footer>
<style is:global>
.foot{flex:0 0 auto;position:relative;z-index:2;background:var(--bg);border-radius:16px;padding:0 10px;max-width:1600px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:4px 14px;flex-wrap:wrap;font-size:13px;color:var(--mute)}
.foot .logo{font-size:22px;color:#fff;min-height:0}
.foot nav{display:flex;gap:2px;flex-wrap:wrap}
.foot nav a{display:flex;align-items:center;min-height:44px;padding:0 8px;border-radius:10px}
.foot nav a:hover{color:#fff}
@media (min-width:900px){.foot{padding:0 8px}}
</style>
