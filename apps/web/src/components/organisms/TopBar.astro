---
/** Barre du haut des pages secondaires : logo vers l'accueil et bouton « télécharger ». */
import Logo from '../atoms/Logo.astro';
import { nav } from '../../content/landing';
interface Props {
  /** libellé du bouton « télécharger » (pages traduites) */
  downloadLabel?: string;
  /** libellé du logo pour les lecteurs d'écran */
  homeLabel?: string;
}
const { downloadLabel = nav.download, homeLabel = 'blowy, accueil' } = Astro.props;
---
<header class="nav">
  <div class="pill">
    <Logo href="/" label={homeLabel} />
    <a class="dl" href="/#go"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M5 19h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{downloadLabel}</a>
  </div>
</header>
