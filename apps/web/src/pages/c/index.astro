---
/**
 * Code d'un créateur : /c/<code> (réécrit vers cette page). « De la part de … », stores, « J'ai déjà Minimoa »
 * (minimoa://c/CODE) et le code à taper à l'inscription (« Un code ? »). La visite est comptée par l'API (sans IP).
 * Aucune empreinte : la source n'arrive dans l'app que par ce lien ouvert, ou par le code tapé (docs/VIRALITE.md).
 */
import Public from '../../layouts/Public.astro';
import StoreButtons from '../../components/molecules/StoreButtons.astro';
import LoadingState from '../../components/organisms/public/LoadingState.astro';
import CodeBox from '../../components/organisms/public/CodeBox.astro';
import { growthCopy } from '../../content/growth';

const t = growthCopy.fr.creator;
---
<Public title={t.meta} description={t.description} noindex ogImage="/og/i.jpg" ogAlt="Nino, un minimoa vert, qui fait coucou.">
  <LoadingState />
  <section class="pub-state" data-state="ready" hidden aria-live="polite">
    <img class="pub-pet" src="/img/m/nino_coucou.webp" alt="" width="450" height="500" />
    <span class="lbl" data-c="label">{t.label}</span>
    <h1 class="pub-title" tabindex="-1" data-creator-title></h1>
    <p class="pub-text" data-creator-text>{t.intro}</p>
    <div class="pub-actions"><a class="btn l" data-open href="minimoa://" data-c="open">{t.open}</a></div>
    <StoreButtons />
    <CodeBox label={t.codeLabel} help={t.codeHelp} copy={growthCopy.fr.copy} box="creator" />
  </section>
</Public>
<script>
  import '../../scripts/creator-page';
</script>
