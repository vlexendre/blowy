---
/** /<langue>/quartier/ : la page indexée « quartier » traduite (en, es, pt, nl). */
import Public from '../../../layouts/Public.astro';
import QuartierBody from '../../../components/templates/QuartierBody.astro';
import { quizCopy } from '../../../content/quiz';
import { TRANSLATED_LOCALES, type Locale } from '../../../i18n/site';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<Public locale={lang} wide seoPath="/quartier/" meta={(l) => quizCopy[l].quartier.meta} ogImage={(l) => `/og/${l}/quartier.jpg`}>
  {(l: Locale) => <QuartierBody locale={l} />}
</Public>
<script>
  import '../../../scripts/quartier-page';
</script>
