---
/** /<langue>/quiz/ : la page indexée « quiz » traduite (en, es, pt, nl). */
import Public from '../../../layouts/Public.astro';
import QuizBody from '../../../components/templates/QuizBody.astro';
import { quizCopy } from '../../../content/quiz';
import { TRANSLATED_LOCALES, type Locale } from '../../../i18n/site';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<Public locale={lang} seoPath="/quiz/" meta={(l) => quizCopy[l].quiz.meta} ogImage={(l) => `/og/${l}/quiz.jpg`}>
  {(l: Locale) => <QuizBody locale={l} />}
</Public>
<script>
  import '../../../scripts/quiz-page';
</script>
