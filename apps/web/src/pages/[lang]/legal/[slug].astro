---
/** Pages légales traduites : /<langue>/legal/<page> (en, es, pt, nl). La version française fait foi. */
import LegalDocument from '../../../components/organisms/legal/LegalDocument.astro';
import { LEGAL_SLUGS, TRANSLATED_LOCALES, type LegalSlug, type Locale } from '../../../i18n/legal';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.flatMap((lang) => LEGAL_SLUGS.map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as LegalSlug;
---
<LegalDocument locale={lang} slug={slug} />
