---
/** Landing traduite : /en/, /es/, /pt/, /nl/. */
import LandingPage from '../../components/templates/LandingPage.astro';
import { TRANSLATED_LOCALES, type Locale } from '../../i18n/site';

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<LandingPage locale={lang} />
