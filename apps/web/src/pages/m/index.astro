---
/** « 3 mots » : /m/CODE (réécrit vers cette page) ou /m/?c=CODE. Tout se passe côté navigateur. */
import Public from '../../layouts/Public.astro';
import StateBlock from '../../components/molecules/StateBlock.astro';
import LoadingState from '../../components/organisms/public/LoadingState.astro';
import NetworkError from '../../components/organisms/public/NetworkError.astro';
import DownloadCta from '../../components/organisms/public/DownloadCta.astro';
import WordsPicker from '../../components/organisms/public/WordsPicker.astro';
import { common, wordsPage as c } from '../../content/public';
---
<Public title={c.meta.title} description={c.meta.description} noindex>
  <LoadingState />
  <WordsPicker />
  <StateBlock state="done" title={c.doneTitle} text={c.doneText}>
    <img slot="pet" class="pub-pet" data-pet-done alt="" width="900" height="1000" />
    <DownloadCta />
  </StateBlock>
  <StateBlock state="not_found" title={c.notFoundTitle} text={c.notFoundText} pet={{ src: '/img/nino_triste.webp', alt: '' }}>
    <div class="pub-actions"><a class="btn l" href="/">{common.home}</a></div>
    <DownloadCta />
  </StateBlock>
  <StateBlock state="already_done" title={c.alreadyTitle} text={c.alreadyTextNoName}>
    <img slot="pet" class="pub-pet" data-pet-already src="/img/nino_smug.webp" alt="" width="900" height="1000" />
    <DownloadCta />
  </StateBlock>
  <NetworkError />
</Public>
<script>
  import '../../scripts/words-page';
</script>
