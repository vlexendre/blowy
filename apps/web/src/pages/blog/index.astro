---
/** /blog/ : les articles du blog, du plus récent au plus ancien. */
import Editorial from '../../layouts/Editorial.astro';
import LinkCards from '../../components/organisms/editorial/LinkCards.astro';
import AppCta from '../../components/organisms/editorial/AppCta.astro';
import { BLOG_LIST, blogPath } from '../../content/editorial/blog';
import { GUIDE_LIST, guidePath } from '../../content/editorial/guides';
import { editorialUi, frDate } from '../../content/editorial/ui';
import { SITE_URL } from '../../config/site';

const t = editorialUi.blog;
const blog = {
  '@type': 'Blog',
  name: t.feedTitle,
  url: new URL(t.path, SITE_URL).href,
  inLanguage: 'fr-FR',
  blogPost: BLOG_LIST.map((p) => ({ '@type': 'BlogPosting', headline: p.h1, url: new URL(blogPath(p.slug), SITE_URL).href, datePublished: p.published })),
};
---
<Editorial title={t.meta.title} description={t.meta.description} path={t.path} ogImage="/og/blog.jpg" ogAlt={t.ogAlt} crumbs={[{ name: t.crumb, path: t.path }]} jsonLd={[blog]} preloadImage="/img/m/bande_fete.webp">
  <header class="ed-head">
    <h1>{t.h1}</h1>
    <p class="ed-lead">{t.lead}</p>
    <img class="ed-art wide" src="/img/m/bande_fete.webp" alt="Nino, Suzie, Gaston et Pia, quatre minimoas, qui font la fête" width="1200" height="421" fetchpriority="high" decoding="async" />
  </header>
  <LinkCards title={t.listTitle} items={BLOG_LIST.map((p) => ({ href: blogPath(p.slug), title: p.short, text: `${frDate(p.published)} · ${p.meta.description}` }))} />
  <LinkCards title={editorialUi.guides.h1} items={GUIDE_LIST.map((g) => ({ href: guidePath(g.slug), title: g.short }))} />
  <AppCta />
</Editorial>
