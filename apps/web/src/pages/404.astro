---
/** Page introuvable, avec nino tout triste. */
import Public from '../layouts/Public.astro';
import StateBlock from '../components/molecules/StateBlock.astro';
import { common, notFoundPage as c } from '../content/public';
---
<Public title={c.meta.title} description={c.meta.description} noindex>
  <StateBlock state="404" title={c.title} text={c.text} pet={{ src: '/img/nino_triste.webp', alt: c.petAlt }} visible>
    <div class="pub-actions"><a class="btn l" href="/">{common.home}</a><a class="btn g" href="/support">aide</a></div>
  </StateBlock>
</Public>
