---
/**
 * /g/… (réécrit vers cette page, public/_redirects). Deux cas (docs/DEEPLINKS.md) :
 * - /g/<identifiant> : un groupe de l'app, ouvert sans l'app → « Ouvre Minimoa » (membres seulement) ;
 * - /g/<code> : le lien d'invitation d'un groupe → nom, habitude, jours tenus, nombre de membres et leurs minimoas
 *   (jamais de prénom ni de position), « Rejoindre dans l'app », stores et le code à taper à l'inscription.
 * Cinq langues rendues au build, celle du téléphone montrée ; le reste côté navigateur (scripts/group-page.ts).
 */
import Public from '../../layouts/Public.astro';
import StateBlock from '../../components/molecules/StateBlock.astro';
import StoreButtons from '../../components/molecules/StoreButtons.astro';
import LoadingState from '../../components/organisms/public/LoadingState.astro';
import NetworkError from '../../components/organisms/public/NetworkError.astro';
import CodeBox from '../../components/organisms/public/CodeBox.astro';
import OpenState from '../../components/organisms/public/OpenState.astro';
import { growthCopy } from '../../content/growth';
import { openCopy } from '../../content/open';
import { localePath, type Locale } from '../../i18n/site';
---
<Public shell="always" noindex ogImage="/og/g.jpg" meta={(l) => ({ title: growthCopy[l].group.meta, description: growthCopy[l].group.description, ogAlt: openCopy[l].kinds.g.title.join(' ') })}>
  {
    (l: Locale) => {
      const t = growthCopy[l].group;
      return (
        <>
          <LoadingState locale={l} />
          <OpenState locale={l} kind="g" hidden />
          <section class="pub-state grp" data-state="ready" hidden aria-live="polite">
            <span class="lbl">{t.label}</span>
            <h1 class="pub-title" tabindex="-1" data-group-name />
            <div class="grp-chips">
              <span class="grp-chip acc" data-group-habit />
              <span class="grp-chip" data-group-members />
            </div>
            <div class="grp-pets" data-group-pets aria-hidden="true" />
            <p class="pub-text" data-group-days />
            <p class="grp-note" data-group-missing hidden />
            <div class="pub-actions">
              <a class="btn l" data-join href="minimoa://g">{t.open}</a>
            </div>
            <StoreButtons locale={l} />
            <CodeBox label={t.codeLabel} help={t.codeHelp} copy={growthCopy[l].copy} box="group" />
          </section>
          <StateBlock state="not_found" title={t.notFoundTitle} text={t.notFoundText} pet={{ src: '/img/nino_triste.webp', alt: '' }}>
            <div class="pub-actions"><a class="btn l" href={localePath(l, '/')}>{t.home}</a></div>
            <div class="pub-dl">
              <b>{t.downloadTitle}</b>
              <p>{t.downloadText}</p>
              <StoreButtons locale={l} />
            </div>
          </StateBlock>
          <NetworkError locale={l} />
        </>
      );
    }
  }
</Public>
<style is:global>
.grp-chips{display:flex;flex-wrap:wrap;gap:8px}
.grp-chip{display:inline-flex;align-items:center;border-radius:999px;padding:7px 13px;font-size:14px;font-weight:800;background:rgba(255,255,255,.10)}
.grp-chip.acc{background:var(--lime);color:var(--ink)}
.grp-chip:empty{display:none}
.grp-pets{display:flex;align-items:flex-end}
.grp-pets img{width:64px;height:64px;border-radius:50%;margin-left:-12px;border:3px solid var(--night, #0B0A14);background:rgba(255,255,255,.08);object-fit:cover}
.grp-pets img:first-child{margin-left:0}
.grp-note{font-weight:800;color:var(--lime)}
.grp-note[hidden]{display:none}
</style>
<script>
  import '../../scripts/group-page';
</script>
