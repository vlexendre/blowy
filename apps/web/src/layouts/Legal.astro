---
/**
 * Gabarit des pages légales, dans toutes les langues : barre du haut, titre, date de mise à jour,
 * sélecteur de langue, bandeau « la version française fait foi », encadré « En bref », sommaire,
 * contenu (slot), liste des autres documents, pied de page localisé. Balises hreflang dans <head>.
 */
import Base from './Base.astro';
import TopBar from '../components/organisms/TopBar.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';
import { LEGAL_UPDATED_ISO } from '../config/legal';
import type { LegalUi } from '../content/legal/types';
import { DEFAULT_LOCALE, LEGAL_SLUGS, LOCALES, LOCALE_NAME, LOCALE_REGION, formatDate, legalAlternates, legalPath, type LegalSlug, type Locale } from '../i18n/legal';
import { inline, type Heading } from '../lib/legal-render';

interface Props {
  locale: Locale;
  /** page affichée ; absente pour le sommaire /legal */
  slug?: LegalSlug;
  ui: LegalUi;
  title: string;
  heading: string;
  description: string;
  intro?: string;
  summary?: { title: string; items: string[] };
  toc?: Heading[];
}
const { locale, slug, ui, title, heading, description, intro, summary, toc } = Astro.props;
const updated = formatDate(LEGAL_UPDATED_ISO, locale);
const footerLinks = ui.footerLinks.map((l) => ({ href: l.slug === 'index' ? legalPath(locale) : legalPath(locale, l.slug), label: l.label }));
const others = LEGAL_SLUGS.filter((s) => s !== slug);
---
<Base
  title={title}
  description={description}
  bodyClass="prose-body"
  lang={locale}
  ogLocale={LOCALE_REGION[locale].og}
  alternates={legalAlternates(slug)}
  skipLabel={ui.skip}
>
  <TopBar downloadLabel={ui.download} />
  <main id="main" class="prose-main">
    <article class="prose">
      <header class="prose-head">
        <nav class="langs" aria-label={ui.languageLabel}>
          {
            LOCALES.map((l) => (
              <a href={legalPath(l, slug)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>
                {LOCALE_NAME[l]}
              </a>
            ))
          }
        </nav>
        {
          ui.translationNotice && (
            <p class="note lang-note">
              {ui.translationNotice} <a href={legalPath(DEFAULT_LOCALE, slug)} hreflang="fr" lang="fr">{ui.frenchVersion}</a>
            </p>
          )
        }
        <h1>{heading}</h1>
        {intro && <p class="prose-intro" set:html={inline(intro, locale)} />}
        <p class="prose-date">{ui.updated} <time datetime={LEGAL_UPDATED_ISO}>{updated}</time></p>
      </header>
      {
        summary && (
          <aside class="summary" aria-labelledby="summary-title">
            <h2 id="summary-title">{summary.title}</h2>
            <ul>
              {summary.items.map((i) => (
                <li set:html={inline(i, locale)} />
              ))}
            </ul>
          </aside>
        )
      }
      {
        toc && toc.length > 0 && (
          <nav class="toc" aria-labelledby="toc-title">
            <h2 id="toc-title">{ui.tocLabel}</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.id}`} set:html={inline(h.text, locale)} />
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
      {
        slug && (
          <nav class="others" aria-labelledby="others-title">
            <h2 id="others-title">{ui.otherDocs}</h2>
            <ul>
              {others.map((s) => (
                <li>
                  <a href={legalPath(locale, s)}>{ui.short[s]}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </article>
  </main>
  <SiteFooter slot="footer" class="prose-foot" links={footerLinks} label={ui.footerLabel} />
</Base>
<style is:global>
.prose-body{background:var(--bg)}
.prose-main{position:relative;padding:calc(var(--top) + 16px) max(16px, env(safe-area-inset-right, 0px)) 40px max(16px, env(safe-area-inset-left, 0px))}
.prose-main::before{content:"";position:absolute;inset:0 0 auto 0;height:520px;z-index:-1;pointer-events:none;background:radial-gradient(60% 70% at 20% 0%,rgba(109,61,240,.35),transparent 70%),radial-gradient(40% 50% at 90% 10%,rgba(255,184,0,.14),transparent 70%)}
.prose{max-width:720px;margin:0 auto;font-size:17px;line-height:1.6;color:#E7E4F2;overflow-wrap:break-word}
.prose-head{margin-bottom:28px}
.prose h1{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(40px,10vw,80px);line-height:.95;color:#fff;overflow-wrap:break-word;hyphens:auto;text-wrap:balance}
.prose-intro{margin-top:20px;font-size:19px;color:#fff;font-weight:600;text-wrap:pretty}
.prose-date{margin-top:12px;font-size:14px;color:var(--mute)}
.prose h2{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(26px,5vw,34px);line-height:1.05;color:#fff;margin:44px 0 12px;letter-spacing:.01em;scroll-margin-top:calc(var(--top) + 8px);text-wrap:balance}
.prose h3{font-size:18px;font-weight:800;color:#fff;margin:26px 0 8px;scroll-margin-top:calc(var(--top) + 8px)}
.prose p,.prose ul,.prose ol,.prose dl,.prose table{margin:0 0 14px}
.prose ul,.prose ol{padding-left:1.3em}
.prose li{margin:4px 0}
.prose li::marker{color:var(--lime)}
.prose strong{color:#fff}
.prose a{color:var(--lime);font-weight:700;text-decoration:underline;text-underline-offset:3px}
.prose a:hover{text-decoration-thickness:2px}
.prose .note{padding:14px 18px;border-radius:18px;background:rgba(255,255,255,.06);border:1px solid var(--line);font-size:15px}
.prose .tbl{overflow-x:auto;margin:0 0 14px;border-radius:18px;border:1px solid var(--line)}
.prose table{width:100%;border-collapse:collapse;font-size:15px;margin:0}
.prose th,.prose td{text-align:left;vertical-align:top;padding:10px 14px;border-bottom:1px solid var(--line)}
.prose tr:last-child td{border-bottom:0}
.prose th{color:#fff;background:rgba(255,255,255,.05);font-weight:800}
.prose details{border-radius:18px;background:rgba(255,255,255,.05);border:1px solid var(--line);margin:0 0 10px}
.prose details[open]{background:rgba(255,255,255,.08)}
.prose summary{cursor:pointer;list-style:none;padding:16px 48px 16px 18px;font-weight:800;color:#fff;position:relative;font-size:17px;line-height:1.35;border-radius:18px}
.prose summary::-webkit-details-marker{display:none}
.prose summary::after{content:"+";position:absolute;right:16px;top:50%;translate:0 -50%;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1}
.prose details[open] summary::after{content:"–";background:var(--lime);color:var(--ink)}
.prose details>div{padding:0 18px 4px}
.prose mark.todo{background:var(--lime);color:var(--ink);font-weight:800;padding:1px 6px;border-radius:6px;white-space:nowrap}
.langs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px}
.prose .langs a{display:inline-flex;align-items:center;min-height:36px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:#E7E4F2;font-size:14px;font-weight:700;text-decoration:none}
.prose .langs a:hover{background:rgba(255,255,255,.1)}
.prose .langs a[aria-current="page"]{background:var(--lime);border-color:var(--lime);color:var(--ink)}
.prose .lang-note{margin-bottom:22px}
.summary{margin:0 0 8px;padding:18px 20px 6px;border-radius:22px;background:rgba(255,255,255,.07);border:1px solid var(--line);border-left:4px solid var(--lime)}
.prose .summary h2{margin:0 0 10px;font-size:24px}
.toc{margin:28px 0 0;padding:16px 20px 4px;border-radius:22px;border:1px solid var(--line)}
.prose .toc h2{margin:0 0 8px;font-size:22px}
.prose .toc ol{columns:2 260px;column-gap:28px;font-size:15px}
.prose .toc li{break-inside:avoid}
.prose .toc a{font-weight:600}
.others{margin-top:56px;padding-top:8px;border-top:1px solid var(--line)}
.prose .others h2{font-size:24px;margin-top:24px}
.prose .others ul{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.prose .others li{margin:0}
.prose .others a{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid var(--line);font-size:15px;text-decoration:none}
.prose .others a:hover{background:rgba(255,255,255,.12)}
@media (max-width:599px){
  .prose .tbl{overflow:visible}
  .prose .tbl table,.prose .tbl tbody,.prose .tbl tr,.prose .tbl td{display:block}
  .prose .tbl thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .prose .tbl tr{padding:12px 14px;border-bottom:1px solid var(--line)}
  .prose .tbl tr:last-child{border-bottom:0}
  .prose .tbl td{padding:2px 0;border:0}
  .prose .tbl td:first-child{color:#fff;font-weight:800;margin-bottom:2px}
  .prose .tbl td[data-label]::before{content:attr(data-label) ": ";color:var(--mute);font-weight:700}
  .prose:lang(fr) .tbl td[data-label]::before{content:attr(data-label) "\202F: "}
}
.prose-foot{margin:0 auto 16px;width:calc(100% - 32px)}
</style>
