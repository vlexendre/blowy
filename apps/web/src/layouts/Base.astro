---
/**
 * Gabarit de base : <head> (méta, Open Graph, Twitter, favicon, polices auto-hébergées Anton et Allo), variables CSS issues de @blowy/tokens,
 * lien d'évitement, contenu, emplacement « footer ».
 */
import { color, font, gradient, radius, space } from '@blowy/tokens';
import { OG_ALT, OG_IMAGE, SITE_NAME, SITE_URL } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** classe ajoutée à <html> (ex. « snap » pour la landing) */
  htmlClass?: string;
  /** classe ajoutée à <body> */
  bodyClass?: string;
  noindex?: boolean;
  /** image d'aperçu (1200 × 630), chemin relatif au site */
  ogImage?: string;
  /** texte alternatif de l'image d'aperçu */
  ogAlt?: string;
  /** langue du document (fr par défaut) */
  lang?: string;
  /** locale Open Graph (fr_FR par défaut) */
  ogLocale?: string;
  /** versions dans d'autres langues (balises hreflang) ; chemins relatifs au site */
  alternates?: { hreflang: string; path: string }[];
  /** texte du lien d'évitement */
  skipLabel?: string;
}

const {
  title,
  description,
  htmlClass,
  bodyClass,
  noindex = false,
  ogImage = OG_IMAGE,
  ogAlt = OG_ALT,
  lang = 'fr',
  ogLocale = 'fr_FR',
  alternates = [],
  skipLabel = 'aller au contenu',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

const kebab = (s: string) => s.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
const tokenVars = [
  ...Object.entries(color).map(([k, v]) => `--color-${kebab(k)}:${v}`),
  ...Object.entries(gradient).map(([k, [a, b]]) => `--gradient-${kebab(k)}:linear-gradient(180deg,${a} 0%,${b} 100%)`),
  ...Object.entries(radius).map(([k, v]) => `--radius-${k}:${v}px`),
  ...Object.entries(space).map(([k, v]) => `--space-${k}:${v}px`),
  `--font-display:${font.web.display}`,
  `--font-body:${font.web.body}`,
];
const tokenCss = `:root{${tokenVars.join(';')}}`;
---
<!doctype html>
<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE_URL).href} />)}
    <meta name="theme-color" content={color.night} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preload" href="/fonts/anton/Anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/allo/AlloVariableFriendly.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: 'Anton'; src: url('/fonts/anton/Anton.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Allo'; src: url('/fonts/allo/AlloVariableFriendly.woff2') format('woff2'); font-weight: 100 900; font-style: normal; font-display: swap; }
    </style>
    <style is:inline set:html={tokenCss}></style>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{skipLabel}</a>
    <slot />
    <slot name="footer" />
  </body>
</html>
