---
/**
 * Gabarit de base : <head> (méta, Open Graph, Twitter, favicon, police auto-hébergée Allo (titres en 800)), variables CSS issues de @blowy/tokens,
 * lien d'évitement, contenu, emplacement « footer ».
 */
import { color, font, gradient, radius, space } from '@blowy/tokens';
import { APP_STORE_ID, OG_ALT, OG_IMAGE, SITE_NAME, SITE_URL } from '../config/site';
import { jsonLd } from '../lib/structured-data';
import LangBanner from '../components/organisms/LangBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** classe ajoutée à <html> (ex. « snap » pour la landing) */
  htmlClass?: string;
  /** classe ajoutée à <body> */
  bodyClass?: string;
  noindex?: boolean;
  /** image d'aperçu (1200 × 630), chemin relatif au site */
  ogImage?: string;
  /** texte alternatif de l'image d'aperçu */
  ogAlt?: string;
  /** langue du document (fr par défaut) */
  lang?: string;
  /** locale Open Graph (fr_FR par défaut) */
  ogLocale?: string;
  /** autres locales Open Graph de la même page (og:locale:alternate) */
  ogLocaleAlternates?: string[];
  /** chemin canonique (par défaut : le chemin servi au build) */
  canonicalPath?: string;
  /** bannière « Available in English » (par défaut : dès qu'il y a des versions dans d'autres langues) */
  langBanner?: boolean;
  /** versions dans d'autres langues (balises hreflang) ; chemins relatifs au site */
  alternates?: { hreflang: string; path: string }[];
  /** texte du lien d'évitement */
  skipLabel?: string;
  /** nœuds JSON-LD propres à la page (l'éditeur et le site sont toujours là) : lib/structured-data.ts */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  htmlClass,
  bodyClass,
  noindex = false,
  ogImage = OG_IMAGE,
  ogAlt = OG_ALT,
  lang = 'fr',
  ogLocale = 'fr_FR',
  alternates = [],
  ogLocaleAlternates = [],
  canonicalPath,
  skipLabel = 'aller au contenu',
  structuredData = [],
} = Astro.props;
const langBanner = Astro.props.langBanner ?? (alternates.length > 0 && !noindex);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

const kebab = (s: string) => s.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
const tokenVars = [
  ...Object.entries(color).map(([k, v]) => `--color-${kebab(k)}:${v}`),
  ...Object.entries(gradient).map(([k, [a, b]]) => `--gradient-${kebab(k)}:linear-gradient(180deg,${a} 0%,${b} 100%)`),
  ...Object.entries(radius).map(([k, v]) => `--radius-${k}:${v}px`),
  ...Object.entries(space).map(([k, v]) => `--space-${k}:${v}px`),
  // Le site n'a qu'une police : Allo, titres compris (graisse 800).
  `--font-display:'Allo', sans-serif`,
  `--font-body:${font.web.body}`,
];
const tokenCss = `:root{${tokenVars.join(';')}}`;
/** Police Allo réduite (scripts/fonts/subset-allo.sh) : nom à empreinte, mise en cache un an. */
const ALLO_FONT = '/fonts/allo/allo-latin.10665227.woff2';
---
<!doctype html>
<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE_URL).href} />)}
    {!noindex && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
    <meta name="theme-color" content={color.night} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preload" href={ALLO_FONT} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Allo';src:url('${ALLO_FONT}') format('woff2');font-weight:400 800;font-style:normal;font-display:swap}`}></style>
    <style is:inline set:html={tokenCss}></style>
    <script type="application/ld+json" set:html={jsonLd(structuredData)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{skipLabel}</a>
    <slot />
    <slot name="footer" />
    {langBanner && <LangBanner />}
    <script>
      // `?ref=<code>` (créateur) : gardé le temps de la visite et ajouté aux boutons qui ouvrent l'app (docs/VIRALITE.md).
      import { applyRef } from '../scripts/ref';
      applyRef();
    </script>
  </body>
</html>
