---
/** Gabarit des pages publiques (3 mots, invitation, 404) : fond de nuit, carte centrée, pied de page. */
import Base from './Base.astro';
import Background from '../components/organisms/landing/Background.astro';
import TopBar from '../components/organisms/TopBar.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Pleine page sans carte, sans barre ni fond animé : la page dessine tout elle-même (« 3 mots »). */
  bare?: boolean;
}
const { title, description, noindex = false, bare = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} bodyClass="pub-body">
  {
    bare ? (
      <main id="main" class="pub-bare">
        <slot />
      </main>
    ) : (
      <>
        <Background />
        <TopBar />
        <main id="main" class="pub">
          <div class="pub-card">
            <slot />
          </div>
        </main>
      </>
    )
  }
  <SiteFooter slot="footer" class="pub-foot" />
</Base>
<style is:global>
.pub-body{min-height:100vh;min-height:100svh;display:flex;flex-direction:column}
.pub{position:relative;z-index:1;flex:1;display:flex;justify-content:center;align-items:flex-start;padding:calc(var(--top) + 8px) max(16px, env(safe-area-inset-right, 0px)) 24px max(16px, env(safe-area-inset-left, 0px))}
.pub-card{position:relative;width:100%;max-width:600px;border-radius:var(--r);background:var(--g-night);border:1px solid var(--line);padding:clamp(20px,5vw,40px);box-shadow:0 24px 60px rgba(0,0,0,.35);isolation:isolate;overflow:hidden}
.pub-card::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(90% 60% at 80% 0%,rgba(109,61,240,.28),transparent 60%)}
.pub-state{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
.pub-state[hidden]{display:none}
.pub-pet{width:clamp(150px,42vw,220px);height:auto;align-self:center;filter:drop-shadow(0 18px 24px rgba(0,0,0,.4))}
.pub-title{font-family:var(--display);font-weight:400;text-transform:uppercase;line-height:.95;letter-spacing:.005em;font-size:clamp(38px,10.5vw,68px);overflow-wrap:anywhere;outline:none}
.pub-title .ln{display:block}
.pub-title .dim{opacity:.38}
.pub-title .acc{color:var(--lime)}
.pub-text{font-size:16px;line-height:1.45;color:var(--mute);max-width:32em;text-wrap:pretty}
.pub-text b{color:#fff}
.pub .lbl{color:var(--mute)}
.pub-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:4px}
.pub .btn{height:52px;font-size:16px}
.pub .btn.g{background:rgba(255,255,255,.08);border-color:var(--line)}
.pub .btn[aria-disabled="true"],.pub button.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.pub .stores{flex-wrap:wrap}
.pub-dl{width:100%;margin-top:10px;padding-top:18px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.pub-dl>b{font-family:var(--display);font-weight:400;font-size:24px;text-transform:uppercase;line-height:1}
.pub-dl>p{color:var(--mute);font-size:14px}
.spin{width:44px;height:44px;border-radius:50%;border:4px solid rgba(255,255,255,.14);border-top-color:var(--lime);animation:spin .8s linear infinite;align-self:center;margin:30px 0 4px}
.pub-loading{align-items:center;text-align:center;padding:20px 0}
.pub-loading p{color:var(--mute);font-weight:700}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spin{animation-duration:3s}}
.pub-foot{margin:0 auto 16px;width:calc(100% - 32px)}
</style>
