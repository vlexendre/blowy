# apps/web — exemple LOCAL. Aucune variable NEXT_PUBLIC_* : tout est lu côté serveur.
WEB_API_URL=http://localhost:3000
BLOWY_ENV=local
APP_STORE_URL=https://apps.apple.com/app/id0000000000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.blowy
# Associations de domaine (blowy.app) — requis en production, sinon les fichiers répondent 404.
APPLE_TEAM_ID=
IOS_BUNDLE_IDS=app.blowy
ANDROID_PACKAGE=app.blowy
ANDROID_SHA256_FINGERPRINTS=
