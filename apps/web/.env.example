# URL de base de l'API Minimoa (sans /v1). Lue au build : changer de valeur impose de reconstruire.
PUBLIC_API_URL=http://localhost:3000

# Identifiant d'équipe Apple (10 caractères) : liens universels iOS (/.well-known/apple-app-site-association).
# Obligatoire en production ; absent, le fichier ne déclare aucune app (avertissement au build).
APPLE_TEAM_ID=

# Fiches des stores, lues au build. Vides tant que l'app n'est pas publiée : les boutons disent « Bientôt sur … », sans lien.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
