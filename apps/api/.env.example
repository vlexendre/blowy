# apps/api — exemple de configuration LOCALE (aucun secret réel). Copier en .env.
BLOWY_ENV=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://blowy:blowy@localhost:5432/blowy
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:8081,http://localhost:3001,http://localhost:3002

# Auth : local (LocalAuthProvider déterministe, interdit en production) | firebase
AUTH_PROVIDER=local
# Secret HMAC des jetons de session (>= 32 caractères ; générer une valeur propre par environnement)
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
SESSION_TTL_DAYS=60
DEV_AUTH_BYPASS=false
# Firebase (requis si AUTH_PROVIDER=firebase) — l'émulateur est optionnel (profil compose)
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_SERVICE_ACCOUNT_JSON=   # secret serveur, jamais dans un bundle client

# Adaptateurs (production : réels obligatoires)
MODERATION_PROVIDER=local
VERIFICATION_PROVIDER=local_demo
BILLING_PROVIDER=local_demo
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# OPENAI_API_KEY=
# OPENAI_MODERATION_MODEL=omni-moderation-latest

# Stockage S3 local (MinIO compose, chemin forcé)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=blowy-local
S3_ACCESS_KEY=blowy-local
S3_SECRET=blowy-local-secret
S3_FORCE_PATH_STYLE=true

RATE_LIMIT_PER_MINUTE=120
WORKER_OUTBOX_POLL_MS=500
