# apps/api — exemple de configuration LOCALE (aucun secret réel). Copier en .env.
BLOWY_ENV=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://blowy:blowy@localhost:5432/blowy
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:8081,http://localhost:3001,http://localhost:3002

# Auth : local (LocalAuthProvider déterministe, interdit en production) | firebase
AUTH_PROVIDER=local
# Secret HMAC des jetons de session (>= 32 caractères ; générer une valeur propre par environnement)
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
SESSION_TTL_DAYS=60
DEV_AUTH_BYPASS=false
# Firebase (requis si AUTH_PROVIDER=firebase) — l'émulateur est optionnel (profil compose)
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_SERVICE_ACCOUNT_JSON=   # secret serveur, jamais dans un bundle client

# Adaptateurs (production : réels obligatoires)
MODERATION_PROVIDER=local
VERIFICATION_PROVIDER=local_demo
BILLING_PROVIDER=local_demo
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# IA (agent E, docs/ai/policy.md) : local (déterministe, hors prod) | openai | none
AI_PROVIDER=local
# OPENAI_API_KEY=                      # secret serveur uniquement
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# OPENAI_TEXT_MODEL=                   # à choisir dans la doc modèles actuelle (aucun défaut codé)
# OPENAI_VISION_MODEL=
# OPENAI_TRANSCRIPTION_MODEL=          # ex. modèle de transcription courant (doc speech-to-text)
# OPENAI_TIMEOUT_MS=15000
# AI_PRICE_TABLE_JSON={"version":"openai-pricing-AAAA-MM-JJ","models":{}}
# AI_GLOBAL_COST_MICROS_PER_DAY=50000000
# AI_PER_USER_PER_DAY=400
# Veriff (VERIFICATION_PROVIDER=veriff) — secrets serveur uniquement
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
# VERIFF_BASE_URL=                     # URL API indiquée dans l'intégration Veriff
# VERIFF_CALLBACK_URL=
# MEDIA_TOKEN_SECRET=                  # ≥ 32 caractères, requis en production
PUBLIC_API_URL=http://localhost:3000

# Stockage : fs (local/test sans Docker, interdit en prod) | s3 (MinIO compose ou S3 privé)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.local/storage
# Stockage S3 local (MinIO compose, chemin forcé) — avec STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=blowy-local
S3_ACCESS_KEY=blowy-local
S3_SECRET=blowy-local-secret
S3_FORCE_PATH_STYLE=true

RATE_LIMIT_PER_MINUTE=120
WORKER_OUTBOX_POLL_MS=500
