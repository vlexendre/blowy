{
  "name": "@blowy/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blowy/content": "workspace:*",
    "@blowy/contract": "workspace:*",
    "@blowy/domain": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@supabase/supabase-js": "^2.119.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
