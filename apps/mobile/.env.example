# Variables PUBLIQUES embarquées dans le bundle (préfixe EXPO_PUBLIC_). Aucun secret ici.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
# Clés publiques SDK (non secrètes par conception du fournisseur).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Environnement Blowy (local | test | staging | production) : sélectionne les adaptateurs (démo locale interdite en production).
EXPO_PUBLIC_BLOWY_ENV=local
