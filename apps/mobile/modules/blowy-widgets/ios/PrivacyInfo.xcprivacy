<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité du module local BlowyWidgets (pod lié dans l'app ; audit B4).
  - 1C8F.1 : BlowyShared.swift écrit l'état des widgets dans UserDefaults(suiteName: group…), lu par l'extension ;
  - CA92.1 : BlowyWidgetsModule.swift garde dans UserDefaults.standard les activités déjà démarrées (app seule).
  Aucune donnée collectée, aucun pistage. Repris aussi dans le manifeste de l'app (app.config.ts, ios.privacyManifests).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
