{
  "name": "blowy",
  "private": true,
  "version": "1.0.0",
  "description": "Minimoa — Élève ton minimoa. Il te présente du monde.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter @blowy/api dev",
    "dev:web": "pnpm --filter @blowy/web dev",
    "dev:mobile": "pnpm --filter @blowy/mobile start",
    "dev:admin": "pnpm --filter @blowy/admin dev",
    "build:admin": "pnpm --filter @blowy/admin build",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm i18n:check && pnpm contract:check && pnpm migrations:check && pnpm -r --if-present test",
    "i18n:check": "tsx scripts/i18n-check.mts",
    "i18n:list": "tsx scripts/i18n-check.mts --list",
    "contract:check": "tsx scripts/contract-check.mts",
    "contract:snapshot": "tsx scripts/contract-check.mts --write",
    "migrations:check": "tsx scripts/migrations-check.mts",
    "emails:preview": "tsx scripts/email-previews.mts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
